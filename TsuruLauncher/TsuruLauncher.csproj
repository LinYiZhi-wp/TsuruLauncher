<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TsuruLauncher</AssemblyName>
    <Product>Tsuru Launcher</Product>
    <Company>Tsuru</Company>
    <Title>Tsuru Launcher</Title>
    <Version>2.1.3</Version>
    <AssemblyVersion>2.1.3.0</AssemblyVersion>
    <FileVersion>2.1.3.0</FileVersion>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\**" />

    <!-- 皮肤 3D 预览的网页资源：WebView2 要从**磁盘**加载，所以按 Content 拷到输出目录 -->
    <Content Include="Assets\SkinPreview\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- ⚠ 运行时会在程序目录旁边生成 config.json（仅在 %APPDATA% 不可用时兜底）。
         明确排除它，避免打包时把**开发机上的旧配置**一起发出去。 -->
    <Content Remove="config.json" />
    <None Remove="config.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="3.0.4" />
  </ItemGroup>

</Project>
