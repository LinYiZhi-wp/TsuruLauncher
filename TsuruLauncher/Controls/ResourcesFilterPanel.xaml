<UserControl x:Class="TsuruLauncher.Controls.ResourcesFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:seg="clr-namespace:TsuruLauncher.Controls"
             x:Name="FilterRoot">

    <!-- 资源筛选卡片 —— 由外壳右信息面板在「资源」页承载
         （MainWindow.InfoPanelResourcesFilterHost）。DataContext 由 MainWindow 在导航时注入
         ResourcesViewModel。
         搬出 ResourcesPage 后，模板内原本靠 {RelativeSource AncestorType=Page} 上溯到
         ResourcesViewModel 的绑定全部改成 ElementName=FilterRoot。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="筛选" Style="{StaticResource PanelSectionTitle}"/>

                        <!-- 类别（可折叠长列表） -->
                        <Grid Margin="0,14,0,6">
                            <TextBlock Text="类别" Style="{StaticResource FilterSectionTitle}"/>
                            <Button HorizontalAlignment="Right" Height="24" MinWidth="24" Padding="4,0"
                                    Style="{StaticResource ToolButton}"
                                    Content="{Binding IsCategoryListExpanded, Converter={StaticResource ExpandIconConverter}}"
                                    Command="{Binding ToggleCategoryListCommand}" ToolTip="展开 / 收起类别"/>
                        </Grid>
                        <Grid x:Name="SubCategoryChipGroup"
                              seg:SegmentedIndicator.Host="True"
                              seg:SegmentedIndicator.Axis="Both"
                              seg:SegmentedIndicator.Indicator="{Binding ElementName=SubCategoryChipPill}">
                            <!-- chips 会换行：指示块按目标项的真实坐标（TransformToAncestor）走 X+Y 双轴，
                                 位置仍然只由绝对定位基线 + 一个 TranslateTransform 承担。 -->
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="SubCategoryChipPill" CornerRadius="8" Opacity="0"
                                        Background="{DynamicResource AccentBrush}"/>
                            </Canvas>
                            <ItemsControl ItemsSource="{Binding FilteredSubCategories}"
                                          Visibility="{Binding IsCategoryListExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource FilterChip}" GroupName="ResourceSubCategory" Content="{Binding}"
                                                     Command="{Binding DataContext.SwitchCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource StringsMatchConverter}" Mode="OneWay">
                                                    <Binding Path="DataContext.SelectedTag" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding/>
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- 包含内容 -->
                        <TextBlock Text="包含内容" Style="{StaticResource FilterSectionTitle}" Margin="0,10,0,6"/>
                        <TextBox Style="{StaticResource iOS26.SearchBox}" FontSize="12" Padding="12,7"
                                 Text="{Binding ContentFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="在类别列表里搜索"/>

                        <!-- 运行环境 -->
                        <TextBlock Text="运行环境" Style="{StaticResource FilterSectionTitle}" Margin="0,14,0,6"/>
                        <Grid x:Name="EnvironmentChipGroup"
                              seg:SegmentedIndicator.Host="True"
                              seg:SegmentedIndicator.Axis="Both"
                              seg:SegmentedIndicator.Indicator="{Binding ElementName=EnvironmentChipPill}">
                            <!-- chips 会换行：指示块按目标项的真实坐标（TransformToAncestor）走 X+Y 双轴，
                                 位置仍然只由绝对定位基线 + 一个 TranslateTransform 承担。 -->
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="EnvironmentChipPill" CornerRadius="8" Opacity="0"
                                        Background="{DynamicResource AccentBrush}"/>
                            </Canvas>
                            <ItemsControl ItemsSource="{Binding Environments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource FilterChip}" GroupName="ResourceEnvironment" Content="{Binding}"
                                                     Command="{Binding DataContext.SelectEnvironmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource StringsMatchConverter}" Mode="OneWay">
                                                    <Binding Path="DataContext.SelectedEnvironment" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding/>
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- 游戏版本 -->
                        <TextBlock Text="游戏版本" Style="{StaticResource FilterSectionTitle}" Margin="0,8,0,6"/>
                        <Grid x:Name="GameVersionChipGroup"
                              seg:SegmentedIndicator.Host="True"
                              seg:SegmentedIndicator.Axis="Both"
                              seg:SegmentedIndicator.Indicator="{Binding ElementName=GameVersionChipPill}">
                            <!-- chips 会换行：指示块按目标项的真实坐标（TransformToAncestor）走 X+Y 双轴，
                                 位置仍然只由绝对定位基线 + 一个 TranslateTransform 承担。 -->
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="GameVersionChipPill" CornerRadius="8" Opacity="0"
                                        Background="{DynamicResource AccentBrush}"/>
                            </Canvas>
                            <ItemsControl ItemsSource="{Binding GameVersions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource FilterChip}" GroupName="ResourceGameVersion" Content="{Binding}"
                                                     Command="{Binding DataContext.FilterByVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource StringsMatchConverter}" Mode="OneWay">
                                                    <Binding Path="DataContext.SelectedGameVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding/>
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Button Content="清除筛选" Style="{StaticResource GhostPill}" Margin="0,14,0,0"
                                HorizontalAlignment="Stretch" Height="30" FontSize="12"
                                Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
