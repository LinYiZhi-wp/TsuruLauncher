<Page x:Class="TsuruLauncher.Views.DownloadManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:conv="clr-namespace:TsuruLauncher.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="DownloadManagerPage">

    <Page.Resources>
        <conv:ProgressToIconConverter x:Key="ProgressToIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        
        <!-- Round icon button style -->
        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource iOS26.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Statistics -->
        <Border Grid.Column="0" 
                Background="{DynamicResource iOS26.SidebarLayer}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="20,20,20,16">
                <TextBlock Text="{DynamicResource DownloadManager_StatsTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,40"/>

                <!-- Stat Cards -->
                <Border Background="{DynamicResource Surface4Brush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DownloadManager_TotalProgress}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding TotalProgressText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Surface4Brush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DownloadManager_Speed}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding GlobalSpeedText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Surface4Brush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DownloadManager_Remaining}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding TotalRemainingFiles}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Open Folder Button -->
                <Button Click="OpenFolder_Click" Cursor="Hand" Margin="0,24,0,0"
                        ToolTip="打开下载文件夹">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{DynamicResource Surface4Brush}" 
                                    CornerRadius="14" Padding="16,14"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="📂" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="打开文件夹" FontSize="12" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="浏览已下载的 Mod 文件" FontSize="10" 
                                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content (Task List) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Header -->
            <Border Grid.Row="0" Margin="20,20,20,0">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundIconButton}"
                                Click="Back_Click"
                                ToolTip="返回">
                            <TextBlock Text="←" FontSize="16" FontWeight="Bold"/>
                        </Button>
                        <TextBlock Text="{DynamicResource DownloadManager_Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource RoundIconButton}"
                                Foreground="{DynamicResource WarningBrush}" Background="{DynamicResource WarningGlassBrush}"
                                BorderBrush="{DynamicResource WarningGlassBrush}"
                                Margin="0,0,6,0"
                                Click="RetryFailed_Click"
                                ToolTip="重试失败任务">
                            <TextBlock Text="🔄" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource RoundIconButton}"
                                Margin="0,0,6,0"
                                Click="RemoveCompleted_Click"
                                ToolTip="清除已完成">
                            <TextBlock Text="🗑" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource RoundIconButton}"
                                Foreground="{DynamicResource DangerBrush}" Background="{DynamicResource DangerGlassBrush}"
                                BorderBrush="{DynamicResource DangerGlassBrush}"
                                Click="CancelAll_Click"
                                ToolTip="取消全部任务">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Task List -->
            <ScrollViewer Grid.Row="1" Padding="20,10,20,16">
                <ItemsControl ItemsSource="{Binding ActiveTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource iOS26.CardLayer}" 
                                    CornerRadius="16" 
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Padding="24"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Task Name & Main Progress -->
                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Games24" FontSize="24" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, StringFormat='Minecraft {0}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProgressPercentageText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="✕" 
                                                    Style="{StaticResource iOS26.CapsuleButton}"
                                                    Foreground="{DynamicResource DangerBrush}" Background="{DynamicResource DangerGlassBrush}"
                                                    FontSize="11" Width="30" Height="30"
                                                    VerticalAlignment="Center"
                                                    Click="CancelTask_Click"
                                                    Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Main Progress Bar -->
                                    <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Maximum="1.0" Height="6" Margin="0,0,0,24">
                                        <ProgressBar.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </ProgressBar.Resources>
                                    </ProgressBar>

                                    <!-- Detailed Steps -->
                                    <UniformGrid Grid.Row="2" Columns="4">
                                        <!-- JSON -->
                                        <StackPanel Margin="0,0,15,0">
                                            <Grid>
                                                <TextBlock Text="{DynamicResource DownloadManager_Step_JSON}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <ContentControl Content="{Binding JsonProgress, Converter={StaticResource ProgressToIconConverter}}" 
                                                               HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding JsonProgress}" Maximum="1.0" Height="3" Margin="0,6,0,4"/>
                                            <TextBlock Text="{Binding JsonStatusText}" FontSize="10" Opacity="0.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Libs -->
                                        <StackPanel Margin="0,0,15,0">
                                            <Grid>
                                                <TextBlock Text="{DynamicResource DownloadManager_Step_Libs}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding LibrariesProgress, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding LibrariesProgress}" Maximum="1.0" Height="3" Margin="0,6,0,4"/>
                                            <TextBlock Text="{Binding LibrariesStatusText}" FontSize="10" Opacity="0.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Assets -->
                                        <StackPanel Margin="0,0,15,0">
                                            <Grid>
                                                <TextBlock Text="{DynamicResource DownloadManager_Step_Assets}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding AssetsProgress, StringFormat='{}{0:P0}'}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding AssetsProgress}" Maximum="1.0" Height="3" Margin="0,6,0,4"/>
                                            <TextBlock Text="{Binding AssetsStatusText}" FontSize="10" Opacity="0.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Loader -->
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{DynamicResource DownloadManager_Step_Install}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <ContentControl Content="{Binding ComponentsProgress, Converter={StaticResource ProgressToIconConverter}}" 
                                                               HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding ComponentsProgress}" Maximum="1.0" Height="3" Margin="0,6,0,4"/>
                                            <TextBlock Text="{Binding ComponentsStatusText}" FontSize="10" Opacity="0.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>