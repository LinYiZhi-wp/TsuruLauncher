<UserControl x:Class="TsuruLauncher.Controls.SkinPreviewWeb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="300"
             Background="Transparent">
    <Grid x:Name="Root" Background="Transparent">
        <!-- 3D 预览交给网页里的 three.js 渲染（WPF 的 Viewport3D 做不出最近邻采样和正确的透明层） -->
        <wv2:WebView2 x:Name="View" DefaultBackgroundColor="Transparent"/>

        <!-- 没皮肤 / 还没初始化好时的占位 -->
        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock Text="🧍" FontSize="40" HorizontalAlignment="Center" Opacity="0.45"/>
            <TextBlock Text="还没有皮肤" FontSize="12.5" Margin="0,10,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
