<Page x:Class="TsuruLauncher.Views.LabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:motion="clr-namespace:TsuruLauncher.Services.Animation"
      xmlns:anim="clr-namespace:TsuruLauncher.Services.Animation"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1180"
      Title="实验室"
      Background="Transparent">

    <Page.Resources>
        <!-- ============ 圆角梯度（与全站 iOS26 半径对齐） ============
             面板 12 = iOS26.RadiusLarge；内部卡片 10；卡片内嵌小容器 8 = iOS26.RadiusMedium。
             详情覆盖层整块也按 12 收角：它是**不透明**的页面底，直角会把外框
             FrameContainer 的圆角整个盖掉（"圆角外壳 + 直角面板"的断层就是图7 的观感）。 -->
        <CornerRadius x:Key="LabRadiusPanel">12</CornerRadius>
        <CornerRadius x:Key="LabRadiusCard">10</CornerRadius>
        <CornerRadius x:Key="LabRadiusInner">8</CornerRadius>

        <!-- ============ 收藏星标（实心 / 空心切换） ============ -->
        <Style x:Key="LabStarToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}"/>

                            <!-- 悬停高亮：叠加层动画 -->
                            <Border x:Name="HoverBd" CornerRadius="17"
                                    Background="{DynamicResource Surface4Brush}" Opacity="0" IsHitTestVisible="False"/>

                            <!-- ⚠ 星标用两层交叉淡入：空心/实心 + 颜色都在变，
                                 共享画刷做不了 Color 动画，直接换 Text 也是硬切。 -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="StarNormal" Text="&#x2606;" FontSize="18"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="StarChecked" Text="&#x2605;" FontSize="18" Opacity="0"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="StarNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="StarNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StarChecked" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="StarNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StarChecked" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="StarNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 主按钮：强调色实心胶囊 ============ -->
        <Style x:Key="LabPrimaryPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="16" Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"/>

                            <!-- 悬停 / 按下高亮：叠加层动画 -->
                            <Border x:Name="HoverBd" CornerRadius="16"
                                    Background="{DynamicResource AccentHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressBd" CornerRadius="16"
                                    Background="{DynamicResource AccentDimBrush}" Opacity="0" IsHitTestVisible="False"/>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.1" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 次按钮：透明 / 浅底 ============ -->
        <Style x:Key="LabGhostPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="16"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True"/>

                            <!-- 悬停高亮：叠加层动画（底色） -->
                            <Border x:Name="HoverBd" CornerRadius="16"
                                    Background="{DynamicResource Surface5Brush}" Opacity="0" IsHitTestVisible="False"/>

                            <!-- ⚠ 文字色用两层 ContentPresenter 交叉淡入 -->
                            <ContentPresenter x:Name="TextNormal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ContentPresenter x:Name="TextHover" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" Opacity="0" IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextHover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextHover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 分类小灰胶囊标签 ============ -->
        <Style x:Key="LabTag" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ 工具卡：圆角 12 + 1px 描边 + 无阴影 ============ -->
        <Style x:Key="LabToolCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="MinHeight" Value="118"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <!-- hover 颜色过渡：底色和描边都叠在 AdornerLayer 上做 250ms 动画。
                 ⚠ 之前描边还留着 Trigger 直改 BorderBrush（硬切）——
                   现在 HoverTintBorderBrush 也走同一套 Adorner，描边同样有过渡。 -->
            <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
            <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.75"/>
            <Setter Property="motion:MotionAssist.HoverTintBorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
        </Style>

        <!-- ============ 详情面板卡 ============ -->
        <Style x:Key="LabPanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- 详情面板里的"内部卡片"：比外层面板（12）收一档，8~10 区间取 10 -->
            <Setter Property="CornerRadius" Value="{StaticResource LabRadiusCard}"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ==================== 列表视图 ==================== -->
        <!-- 内容区统一内边距（顶 20 / 左右 20 / 底 16）加在 ScrollViewer 的 Padding 上：
             滚动条位于模板右侧列，不受 Padding 影响，仍贴内容区右缘；
             整页浮层 ToolDetailOverlay 是同级兄弟，不在这个内边距里，依旧铺满。 -->
        <ScrollViewer x:Name="ListViewScroll" VerticalScrollBarVisibility="Auto" Padding="20,20,20,16">
            <StackPanel>
                <TextBlock Text="实验室" Style="{StaticResource iOS26.PageTitle}"/>
                <TextBlock x:Name="ToolCountText" Text="0 个工具" Style="{StaticResource iOS26.PageSubtitle}" Margin="0,0,0,18"/>

                <!-- 搜索 + 分类下拉 + 常用下拉 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ToolSearchBox" Grid.Column="0" Style="{StaticResource iOS26.SearchBox}"
                             TextChanged="ToolSearch_Changed" ToolTip="按工具名或说明搜索"/>

                    <ComboBox x:Name="CategoryFilter" Grid.Column="2" SelectedIndex="0"
                              SelectionChanged="Filter_Changed" ToolTip="按分类筛选">
                        <ComboBoxItem Content="全部分类"/>
                        <ComboBoxItem Content="创作"/>
                        <ComboBoxItem Content="世界"/>
                        <ComboBoxItem Content="工具"/>
                    </ComboBox>

                    <ComboBox x:Name="FavoritesFilter" Grid.Column="4" SelectedIndex="0"
                              SelectionChanged="Filter_Changed" ToolTip="只看已收藏的工具">
                        <ComboBoxItem Content="全部工具"/>
                        <ComboBoxItem Content="常用"/>
                    </ComboBox>
                </Grid>

                <!-- 工具卡片列表 -->
                <ItemsControl x:Name="ToolList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LabToolCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 160x90 圆角缩略图：强调色渐变图标块 -->
                                    <Border Grid.Column="0" Width="160" Height="90"
                                            CornerRadius="{StaticResource LabRadiusCard}"
                                            BorderThickness="0" VerticalAlignment="Top" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource AccentDimColor}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Glyph}" FontSize="34"
                                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 右侧：工具名 / 说明 / 分类标签 / 收藏 / 进入 -->
                                    <Grid Grid.Column="1" Margin="16,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource LabStarToggle}"
                                                          IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                          Click="Favorite_Click"/>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12.5"
                                                   Margin="0,6,10,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>

                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource LabTag}" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Category}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="进入 &#x2192;" VerticalAlignment="Bottom"
                                                    Style="{StaticResource LabPrimaryPill}" Click="EnterTool_Click"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border x:Name="EmptyState" Visibility="Collapsed" Style="{StaticResource LabPanelCard}"
                        Padding="28" Margin="0,0,0,12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#x1F50D;" FontSize="30" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="没有匹配的工具" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="换个关键词，或把分类 / 常用筛选改回默认试试。" FontSize="12" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="全部工具都在本地离线计算，不上传任何内容。" FontSize="11.5" Margin="2,2,0,0"
                           Foreground="{DynamicResource TextDimBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 工具详情覆盖层 ==================== -->
        <!-- 遮罩层本身不收角（它只是铺满内容区的底），收角的是它画出来的那块"面板"：
             整块按 12 收角 + ClipToBounds，面板内的卡片再各自 10/8，
             这样从外到内是 12 -> 10 -> 8 的圆角梯度，不会出现直角边。
             ToolDetailPanel 四周留了 20/16 的边距（> 12），内容不会被圆角切到。 -->
        <!-- ⚠ motion:MotionAssist.CacheDisabled="False"：这两个元素面积贴着 1.2MP 安全线
             （实测根 1281280 / 面板 1155592 设备像素），正属于 HANDOFF §6.2 点名的危险档。
             缓存会下沉到 ToolDetailPanel，而它在退出时紧接着要被 Collapsed ——
             「缓存 + 布局变更」会让渲染线程崩：UCEERR_RENDERTHREADFAILURE (0x88980406)，
             表现就是点「返回」整窗卡死（复现率 100%）。
             关掉缓存后实测：进入 p95 16.13ms / max 16.86ms、退出 max 23.51ms，0 崩溃。
             这两处动画都是整页级别的 opacity + transform，逐帧栅格化比渲染线程崩掉便宜得多。 -->
        <Border x:Name="ToolDetailOverlay" Visibility="Hidden" Background="{DynamicResource Surface1Brush}"
                CornerRadius="{StaticResource LabRadiusPanel}" ClipToBounds="True"
                motion:MotionAssist.CacheDisabled="False"
                RenderTransformOrigin="0.5,0.5">
            <Grid x:Name="ToolDetailPanel" Margin="20,20,20,16" RenderTransformOrigin="0.5,0.5"
                  motion:MotionAssist.CacheDisabled="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 详情头部：返回 + 图标 + 名称 + 分类 + 收藏 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="&#x2190; 返回" Click="BackToList_Click"
                            Style="{StaticResource LabGhostPill}" ToolTip="回到工具列表"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailGlyph" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="DetailTitle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Style="{StaticResource LabTag}" Margin="12,0,0,0">
                            <TextBlock x:Name="DetailCategoryText" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <ToggleButton x:Name="DetailFavorite" Grid.Column="2" Style="{StaticResource LabStarToggle}"
                                  IsChecked="{Binding IsFavorite, Mode=TwoWay}" Click="DetailFavorite_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="DetailDescription" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="DetailHintText" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextDimBrush}"/>
                </StackPanel>

                <!-- 工具本体（原有交互全部保留） -->
                <ScrollViewer x:Name="DetailScroll" Grid.Row="2" Margin="0,16,0,0" Padding="0,0,6,24"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ToolPanelGrid">

                        <!-- ========== 崩溃日志分析 ========== -->
                        <Border x:Name="PanelCrash" Style="{StaticResource LabPanelCard}" Visibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="&#x1F50D; 崩溃日志分析" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="把 logs/latest.log 或 crash-report 的内容粘进来，自动识别常见崩溃原因"
                                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,10"/>
                                <TextBox x:Name="CrashInput" Height="170" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="分析" Style="{StaticResource LabPrimaryPill}" Click="AnalyzeCrash_Click"/>
                                    <Button Content="从日志文件读取" Style="{StaticResource LabGhostPill}" Margin="8,0,0,0" Click="LoadCrashFile_Click"/>
                                    <Button Content="清空" Style="{StaticResource LabGhostPill}" Margin="8,0,0,0" Click="ClearCrash_Click"/>
                                </StackPanel>
                                <Border x:Name="CrashResultPanel" Background="{DynamicResource Surface4Brush}"
                                        CornerRadius="{StaticResource LabRadiusInner}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="CrashVerdictText" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="CrashDetailList" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ========== JVM 参数生成器 ========== -->
                        <Border x:Name="PanelJvm" Style="{StaticResource LabPanelCard}" Visibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="&#x2699;&#xFE0F; JVM 参数生成器" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="按内存大小生成推荐的 GC 参数，可直接粘到「设置 &#x2192; 高级 &#x2192; JVM 参数」"
                                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最大内存" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" x:Name="JvmMemorySlider" Minimum="1024" Maximum="32768" Value="4096"
                                            TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="JvmMemory_Changed"
                                            Style="{StaticResource iOS26.GlassSlider}"/>
                                    <TextBlock Grid.Column="2" x:Name="JvmMemoryText" Text="4096 MB" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="10,0,0,0" MinWidth="70"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <CheckBox x:Name="AikarCheck" Content="使用 Aikar 优化参数" IsChecked="True"
                                              Checked="JvmToggle_Changed" Unchecked="JvmToggle_Changed"
                                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <CheckBox x:Name="UseZgcCheck" Content="使用 ZGC（需要 Java 17+）" Margin="18,0,0,0"
                                              Checked="JvmToggle_Changed" Unchecked="JvmToggle_Changed"
                                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="JvmArgsOutput" Margin="0,14,0,0" Height="104" AcceptsReturn="True"
                                         TextWrapping="Wrap" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Padding="8"/>
                                <Button Content="复制参数" Click="CopyJvmArgs_Click" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource LabPrimaryPill}"/>
                            </StackPanel>
                        </Border>

                        <!-- ========== 渐变色文字生成器 ========== -->
                        <Border x:Name="PanelGradient" Style="{StaticResource LabPanelCard}" Visibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="&#x1F3A8; 渐变色文字生成器" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="做启动器横幅 / 服务器名字时的渐变文字" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,12"/>
                                <TextBox x:Name="GradientTextBox" Text="Tsuru Launcher" TextChanged="GradientText_Changed" Padding="8"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GradientColor1" Grid.Column="0" TextChanged="GradientText_Changed"
                                             Margin="0,0,6,0" Padding="8"/>
                                    <TextBox x:Name="GradientColor2" Grid.Column="1" TextChanged="GradientText_Changed"
                                             Margin="6,0,0,0" Padding="8"/>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="角度" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" x:Name="GradientAngle" Minimum="0" Maximum="360" Value="90"
                                            ValueChanged="GradientAngle_Changed" Style="{StaticResource iOS26.GlassSlider}"/>
                                    <TextBlock Grid.Column="2" x:Name="GradientAngleText" Text="90&#xB0;" MinWidth="45"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                                </Grid>
                                <Border Background="{DynamicResource Surface4Brush}"
                                        CornerRadius="{StaticResource LabRadiusInner}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        Padding="16" Margin="0,14,0,0" MinHeight="90">
                                    <TextBlock x:Name="GradientPreview" Text="Tsuru Launcher" FontSize="28" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="复制 CSS" Style="{StaticResource LabPrimaryPill}" Click="CopyGradientCss_Click"/>
                                    <Button Content="复制 XAML" Style="{StaticResource LabGhostPill}" Margin="8,0,0,0" Click="CopyGradientXaml_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ========== 颜色转换 ========== -->
                        <Border x:Name="PanelColor" Style="{StaticResource LabPanelCard}" Visibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="&#x1F9EA; 颜色转换" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="HEX / RGB / HSL 互转，改任意一栏都会同步" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,12"/>
                                <TextBox x:Name="ColorHexBox" TextChanged="ColorHex_Changed" Padding="8"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ColorRBox" Grid.Column="0" TextChanged="ColorRgb_Changed" Margin="0,0,6,0" Padding="8"/>
                                    <TextBox x:Name="ColorGBox" Grid.Column="1" TextChanged="ColorRgb_Changed" Margin="3,0,3,0" Padding="8"/>
                                    <TextBox x:Name="ColorBBox" Grid.Column="2" TextChanged="ColorRgb_Changed" Margin="6,0,0,0" Padding="8"/>
                                </Grid>
                                <Border x:Name="ColorSwatch" Height="72"
                                        CornerRadius="{StaticResource LabRadiusInner}" Margin="0,14,0,0"
                                        Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1"/>
                                <TextBox x:Name="ColorHslBox" Margin="0,14,0,0" IsReadOnly="True" Padding="8"/>
                                <Button Content="复制 HEX" Click="CopyColor_Click" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource LabPrimaryPill}"/>
                            </StackPanel>
                        </Border>

                        <!-- ========== 种子工具 ========== -->
                        <Border x:Name="PanelSeed" Style="{StaticResource LabPanelCard}" Visibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="&#x1F331; 种子工具" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="把文字种子转换成游戏实际使用的数字种子" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,12"/>
                                <TextBox x:Name="SeedInput" Text="Tsuru" TextChanged="Seed_Changed" Padding="8"/>
                                <TextBlock x:Name="SeedOutput" Text="数字种子：" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0"/>
                                <TextBlock x:Name="SeedCopyHint" Text="游戏内可用 /seed 查看当前世界种子" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
                                <Button Content="复制数字种子" Click="CopySeed_Click" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource LabPrimaryPill}"/>
                            </StackPanel>
                        </Border>

                        <!-- ========== 文本 / 编码工具 ========== -->
                        <Border x:Name="PanelText" Style="{StaticResource LabPanelCard}" Visibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="&#x1F524; 文本 / 编码工具" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Base64、URL 编解码与 JSON 美化" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,12"/>
                                <TextBox x:Name="TextToolInput" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Padding="8"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Base64 编码" Style="{StaticResource LabGhostPill}" Click="Base64Encode_Click" Margin="0,0,8,8"/>
                                    <Button Content="Base64 解码" Style="{StaticResource LabGhostPill}" Click="Base64Decode_Click" Margin="0,0,8,8"/>
                                    <Button Content="URL 编码" Style="{StaticResource LabGhostPill}" Click="UrlEncode_Click" Margin="0,0,8,8"/>
                                    <Button Content="URL 解码" Style="{StaticResource LabGhostPill}" Click="UrlDecode_Click" Margin="0,0,8,8"/>
                                    <Button Content="JSON 美化" Style="{StaticResource LabGhostPill}" Click="JsonPretty_Click" Margin="0,0,8,8"/>
                                    <Button Content="清空" Style="{StaticResource LabGhostPill}" Click="ClearTextTool_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBox x:Name="TextToolOutput" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas"
                                         FontSize="12" Padding="8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
