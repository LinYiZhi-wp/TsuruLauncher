<UserControl x:Class="TsuruLauncher.Controls.NotificationToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Width="380" MinHeight="68" Margin="0,8,0,8">
    <UserControl.Resources>
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-60,0,0" To="0,8,0,0" Duration="0:0:0.4">
                <ThicknessAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="20,-60,20,0" Duration="0:0:0.3">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="Container" CornerRadius="16"
            Background="{DynamicResource Surface5Brush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <!-- Glass highlight -->
            <Border CornerRadius="16" Background="{DynamicResource AccentGlassLightBrush}" VerticalAlignment="Top" Height="24"/>
            
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBorder" Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                        Background="{DynamicResource AccentGlassMediumBrush}" Margin="0,0,12,0">
                    <TextBlock x:Name="IconText" Text="ℹ" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="通知" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MessageText" Text="消息内容" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                               MaxHeight="40"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="✕"
                        FontSize="10"
                        Foreground="{DynamicResource TextTertiaryBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="24" Height="24"
                        VerticalAlignment="Top"
                        Margin="8,-2,-4,0"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>