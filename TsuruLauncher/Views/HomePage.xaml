<Page x:Class="TsuruLauncher.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:TsuruLauncher.Services.Animation"
        xmlns:motion="clr-namespace:TsuruLauncher.Services.Animation"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:TsuruLauncher.Converters"
      xmlns:local="clr-namespace:TsuruLauncher.Views"
      mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1180"
      Title="Home" Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <local:WidgetTemplateSelector x:Key="WidgetTemplateSelector"/>

        <!-- 小组件编辑模式：卡片标题行右侧的圆形小按钮（改尺寸 / 移除）。
             刻意做小做轻 —— 编辑态才出现，平时不占视觉。 -->


        <!-- 编辑态下每张卡右上角那组小按钮：出现时 180ms 淡入 + 轻微上浮。
             之前是 Visibility 硬切 —— 用户反馈「多生硬啊」。 -->
        <!-- iOS 风格「毛玻璃」卡片：大圆角 20 + 1px 发丝描边 + 半透明浮层底。
             WPF 没有真正的 backdrop-blur，所以用「半透明底 + 发丝边 + 大圆角」这套
             （和右下 FloatPill 同一组画刷）来拿高级感；按设计红线不加投影。 -->
        <Style x:Key="WidgetGlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceFloatingBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="WidgetEditChipGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHomeEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                 Duration="0:0:0.2"
                                                 EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="-8" To="0" Duration="0:0:0.24"
                                                 EasingFunction="{x:Static anim:AxolotlMotion.OvershootEase}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="8" To="0" Duration="0:0:0.24"
                                                 EasingFunction="{x:Static anim:AxolotlMotion.OvershootEase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                 Duration="0:0:0.12"
                                                 EasingFunction="{x:Static anim:AxolotlMotion.EaseIn}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetEditChip" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="13"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>

                            <!-- ⚠ hover 的底色 / 描边 / 文字色**全部**叠层动画：
                                 直接 Setter 改这三个都是硬切（DynamicResource 画刷共享冻结，
                                 做不了 Color 动画）。文字色用「两层 ContentPresenter 交叉淡入」。 -->
                            <Border x:Name="HoverBd" CornerRadius="13"
                                    Background="{DynamicResource AccentGlassMediumBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Opacity="0" IsHitTestVisible="False"/>

                            <ContentPresenter x:Name="TextNormal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ContentPresenter x:Name="TextHover" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Opacity="0" IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextHover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextHover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Axolotl 的小组件手柄：每张卡右上角一颗 ⣿，点它弹「小组件选项」菜单
             （尺寸 / 向前移动 / 向后移动 / 删除小组件）。光标用 SizeAll，暗示可拖。 -->
        <Style x:Key="WidgetDragHandle" TargetType="Button" BasedOn="{StaticResource WidgetEditChip}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="SizeAll"/>
        </Style>

        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Axolotl 卡片：Instance.vue:272 / ServerCard.vue:81
             transition-[border-color,filter,transform]（=150ms cubic-bezier(0.4, 0, 0.2, 1)）
             加上 active:scale-[0.98]。WPF 侧只动 ScaleTransform，不动布局属性。 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
            <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
            <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
            <!-- hover 颜色过渡：250ms ease-in-out（Axolotl ButtonStyled.vue:267-271 / InstanceRowCard.vue:15），
                 用 AdornerLayer 上的圆角色块动画 Opacity 实现，保留 DynamicResource 画刷。 -->
            <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
            <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.55"/>
        </Style>
        <Style x:Key="MiniCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
            <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
            <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
            <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
            <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.55"/>
        </Style>
        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>
        <Style x:Key="MiniValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}"/>

                            <!-- 悬停高亮：叠加层动画（改 Background 是硬切） -->
                            <Border x:Name="HoverBd" CornerRadius="20"
                                    Background="{DynamicResource AccentHoverBrush}" Opacity="0" IsHitTestVisible="False"/>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"/>

                            <!-- hover 底色 + 文字色都做动画 -->
                            <Border x:Name="HoverBd" CornerRadius="8"
                                    Background="{DynamicResource Surface4Brush}"
                                    Opacity="0" IsHitTestVisible="False"/>

                            <ContentPresenter x:Name="TextNormal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ContentPresenter x:Name="TextHover" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              Opacity="0" IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextHover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextHover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" EasingFunction="{x:Static motion:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形图标按钮（对齐美西螈极简首页的圆形 List 按钮）：
             36px 圆 + ui:SymbolIcon，悬停走 150ms 透明度渐变，无缩放 -->
        <Style x:Key="CircleIconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentGlassLightBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Idle" CornerRadius="{StaticResource RadiusCircle40}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"/>
                            <Border x:Name="Hover" CornerRadius="{StaticResource RadiusCircle40}" Opacity="0"
                                    Background="{DynamicResource AccentGlassMediumBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TplInstance">
<!-- ══ hero：从最近的实例开始（跨整宽）══
                     标题、版本、最近游玩各占一行，「选版本」按钮独立成列 ——
                     旧版标题和按钮挤在同一格里，按钮直接压在标题上（看着像「…开始选版本」）。 -->
                <Border Style="{StaticResource WidgetGlassCard}" Padding="20,18">
<Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource AccentGlassMediumBrush}"
                                motion:MotionAssist.HoverScale="1.03"
                                motion:MotionAssist.HoverScaleMs="150"
                                motion:MotionAssist.HoverScaleEase="EaseInOut">
                            <ui:SymbolIcon Symbol="Cube24" FontSize="22" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="从最近的实例开始" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding DataContext.VersionTitle, RelativeSource={RelativeSource AncestorType=Page}}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DataContext.LastPlayedText, RelativeSource={RelativeSource AncestorType=Page}}" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="创建实例" Click="CreateInstance_Click"
                                    AutomationProperties.Name="创建实例"
                                    Visibility="{Binding DataContext.HasVersions, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVis}}"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding LaunchGameCommand}"
                                    AutomationProperties.Name="开始游戏"
                                    Visibility="{Binding DataContext.HasVersions, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="开始游戏" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="选版本"
                                    Click="OpenVersionSelector_Click"
                                    AutomationProperties.Name="选版本"
                                    Visibility="{Binding DataContext.HasVersions, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource WidgetEditChipGroup}" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>
<Button Style="{StaticResource WidgetDragHandle}" Content="&#x28FF;" ToolTip="拖动排序 / 小组件选项"
                                    Click="WidgetHandle_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>

        </DataTemplate>
        <DataTemplate x:Key="TplStats">
<!-- 今天 -->
                    <Border Style="{StaticResource WidgetGlassCard}" Padding="18">
<StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{Binding DataContext.TodayText, RelativeSource={RelativeSource AncestorType=Page}}" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Style="{StaticResource WidgetEditChipGroup}" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>
<Button Style="{StaticResource WidgetDragHandle}" Content="&#x28FF;" ToolTip="拖动排序 / 小组件选项"
                                    Click="WidgetHandle_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource MiniCard}">
                                    <StackPanel>
                                        <TextBlock Text="今天游玩" Style="{StaticResource MiniLabel}"/>
                                        <TextBlock Text="{Binding DataContext.TodayPlayText, RelativeSource={RelativeSource AncestorType=Page}}" Style="{StaticResource MiniValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MiniCard}">
                                    <StackPanel>
                                        <TextBlock Text="累计启动" Style="{StaticResource MiniLabel}"/>
                                        <TextBlock Text="{Binding DataContext.LaunchCountText, RelativeSource={RelativeSource AncestorType=Page}}" Style="{StaticResource MiniValue}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
        </DataTemplate>
        <DataTemplate x:Key="TplWorlds">
<!-- 最近的世界 -->
                    <Border Style="{StaticResource WidgetGlassCard}" Padding="18">
<Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="最近的世界" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="26"
                                        Content="打开文件夹" Click="OpenGameDir_Click"/>
                                <StackPanel Style="{StaticResource WidgetEditChipGroup}" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>
<Button Style="{StaticResource WidgetDragHandle}" Content="&#x28FF;" ToolTip="拖动排序 / 小组件选项"
                                    Click="WidgetHandle_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding DataContext.RecentWorlds, RelativeSource={RelativeSource AncestorType=Page}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,6"
                                                Cursor="Hand" MouseLeftButtonUp="World_Click" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14" MinHeight="70">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.HasRecentWorlds, RelativeSource={RelativeSource AncestorType=Page}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="将世界标记为收藏后，就会固定在这里。" FontSize="12" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
        </DataTemplate>
        <DataTemplate x:Key="TplAccount">
<!-- 当前账号（摘要 + 运行环境；完整账号管理在右信息面板） -->
                    <Border Style="{StaticResource WidgetGlassCard}" Padding="18">
<Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="当前账号" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <StackPanel Style="{StaticResource WidgetEditChipGroup}" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>
<Button Style="{StaticResource WidgetDragHandle}" Content="&#x28FF;" ToolTip="拖动排序 / 小组件选项"
                                    Click="WidgetHandle_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" IsHitTestVisible="False"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{DynamicResource AccentGlassMediumBrush}">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataContext.PlayerName, RelativeSource={RelativeSource AncestorType=Page}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DataContext.PlayerDetail, RelativeSource={RelativeSource AncestorType=Page}}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource MiniCard}">
                                    <StackPanel>
                                        <TextBlock Text="Java" Style="{StaticResource MiniLabel}"/>
                                        <TextBlock Text="{Binding DataContext.JavaVersionText, RelativeSource={RelativeSource AncestorType=Page}}" Style="{StaticResource MiniValue}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MiniCard}">
                                    <StackPanel>
                                        <TextBlock Text="版本数" Style="{StaticResource MiniLabel}"/>
                                        <TextBlock Text="{Binding DataContext.VersionCountText, RelativeSource={RelativeSource AncestorType=Page}}" Style="{StaticResource MiniValue}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
        </DataTemplate>
        <DataTemplate x:Key="TplNews">
<!-- Minecraft 新闻 -->
                    <Border Style="{StaticResource WidgetGlassCard}" Padding="18">
<Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Minecraft 新闻" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="26"
                                        Content="日志" Click="OpenLogFolder_Click"/>
                                <StackPanel Style="{StaticResource WidgetEditChipGroup}" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform/>
                                </StackPanel.RenderTransform>
<Button Style="{StaticResource WidgetDragHandle}" Content="&#x28FF;" ToolTip="拖动排序 / 小组件选项"
                                    Click="WidgetHandle_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding DataContext.NewsItems, RelativeSource={RelativeSource AncestorType=Page}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,6"
                                                Cursor="Hand" MouseLeftButtonUp="NewsItem_Click" Tag="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
        </DataTemplate>
        <DataTemplate x:Key="TplGreeting">
            <Border Style="{StaticResource WidgetGlassCard}" Padding="20,18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DataContext.TodayText, RelativeSource={RelativeSource AncestorType=Page}}"
                               FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding DataContext.GreetingText, RelativeSource={RelativeSource AncestorType=Page}}"
                               FontSize="20" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Width="40" Height="3" CornerRadius="2" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TplJava">
            <Border Style="{StaticResource WidgetGlassCard}" Padding="18">
                <StackPanel>
                    <TextBlock Text="☕ 运行环境" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource MiniCard}">
                        <StackPanel>
                            <TextBlock Text="Java" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="{Binding DataContext.JavaVersionText, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Style="{StaticResource MiniValue}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MiniCard}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="已安装版本" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="{Binding DataContext.VersionCountText, RelativeSource={RelativeSource AncestorType=Page}}"
                                       Style="{StaticResource MiniValue}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TplShortcuts">
            <Border Style="{StaticResource WidgetGlassCard}" Padding="18">
                <StackPanel>
                    <TextBlock Text="⚡ 快捷操作" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="开始游戏" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <Button Style="{StaticResource GhostButton}" Content="打开游戏目录" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch" Click="OpenGameDir_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="版本设置"
                            HorizontalAlignment="Stretch"
                            Click="OpenVersionSelector_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <!-- ══════════ 极简主页 ══════════
             两态切换不再用 Visibility 硬切：MinimalHomeRoot / DashboardHomeRoot 由
             HomePage.xaml.cs 调用 PageTransition.PlayContentSwitch 做
             「旧内容淡出 + 新内容 scale(0.96)+translateY(12px) 过冲淡入」(250ms)。 -->
        <Grid x:Name="MinimalHomeRoot">
            <!-- 垂直居中：ScrollViewer 会用无限高度测量子元素，VerticalAlignment 不生效，
                 所以套一层 MinHeight=ViewportHeight 的 Grid —— 内容装得下就居中，装不下照常滚动。 -->
            <ScrollViewer x:Name="MinimalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=MinimalScroll}">
                    <!-- Axolotl Settings.vue:395/766-791 的错峰入场：每项 220ms ease + translateY(-8px)，
                         延迟 min(index * 40, 200)ms。 -->
                    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Margin="20,32,20,32"
                                motion:PageAnimation.StaggerChildren="True">
                        <!-- 问候语 + 强调色短线 -->
                        <TextBlock Text="{Binding GreetingText}" FontSize="28" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Width="40" Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Center" Margin="0,12,0,0"/>

                        <!-- 实例卡：左 = 图标 + 版本名/副标题；右 = 开始游戏 / 版本设置 / 圆形选择实例。
                             卡内不再放版本列表 —— 那会让卡片变成「卡住的弹窗」；选实例统一走圆形按钮
                             （VersionSelectorPage），极简主页只留一句话 + 一张卡。 -->
                        <Border Style="{StaticResource WidgetGlassCard}" Padding="22,20" Margin="0,34,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Axolotl HomeMinimal.vue:226：实例图标 transition-transform group-hover:scale-[1.03] -->
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16"
                                        Background="{DynamicResource AccentGlassMediumBrush}"
                                        motion:MotionAssist.HoverScale="1.03"
                                        motion:MotionAssist.HoverScaleMs="150"
                                        motion:MotionAssist.HoverScaleEase="EaseInOut">
                                    <ui:SymbolIcon Symbol="Cube24" FontSize="28" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                                    <!-- 有实例 -->
                                    <StackPanel Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VersionTitle}" FontSize="21" FontWeight="SemiBold"
                                                   FontFamily="Consolas, Microsoft YaHei UI"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding VersionSubtitle}" FontSize="12" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- 没有实例 -->
                                    <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Text="还没有实例">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVersions}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Content="创建实例" Click="CreateInstance_Click"
                                            AutomationProperties.Name="创建实例"
                                            Visibility="{Binding HasVersions, Converter={StaticResource InverseBoolToVis}}"/>
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Command="{Binding LaunchGameCommand}"
                                            AutomationProperties.Name="开始游戏"
                                            Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="开始游戏" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="版本设置"
                                            Click="OpenVersionSettings_Click"
                                            AutomationProperties.Name="版本设置"
                                            Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource CircleIconButton}" Margin="10,0,0,0"
                                            Click="OpenVersionSelector_Click" ToolTip="选择实例"
                                            AutomationProperties.Name="选择实例"
                                            Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══════════ 信息主页（小组件网格） ══════════ -->
        <!-- ══════════ 信息主页（小组件网格） ══════════
             排布规则（这是「卡片排布不好看」的修复点）：
               1. hero 横卡跨整宽 —— 主行动只有一个，不该和统计卡挤在一列；
               2. 下面两行**每行等高**：同一行里的卡片靠 VerticalAlignment=Stretch 拉平，
                  两列总高自然对齐（旧版左 210 / 右 490，右侧拖出一大片空白）；
               3. 「当前账号」的账号摘要 + Java / 版本数原本和右信息面板重复，这里只留紧凑版。 -->
        <!-- 外面套一层 Grid：工具条要**悬浮在视口右下角**（放在 ScrollViewer 里会跟着内容滚走） -->
        <Grid x:Name="DashboardHomeRoot">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="20,20,20,16">
            <StackPanel MaxWidth="1020" HorizontalAlignment="Stretch" Margin="0"
                        motion:PageAnimation.StaggerChildren="True">
                <!-- 日期 + 一句话 -->
                <TextBlock Text="{Binding TodayText}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBlock Text="{Binding GreetingText}" FontSize="24" FontWeight="Bold" Margin="0,6,0,18"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- ══ 小组件网格（数据驱动）══
                     之前这里是**写死的** hero + 2×2 网格，格子满了就没法加新组件类型。
                     现在改成 ItemsControl 绑 HomeWidgets：
                       · 每项按 Kind 选模板（WidgetTemplateSelector）
                       · 宽高来自 HomeWidget.PixelWidth/PixelHeight（尺寸档 1x1 / 2x1 / 1x2 / 2x2 / 3x1 / 3x2）
                       · 顺序即 HomeWidgets 顺序 → 拖拽重排 / 增删都只动集合
                       · WrapPanel 自动换行，窗口变宽也不会挤成一列 -->
                <ItemsControl x:Name="WidgetHost" ItemsSource="{Binding HomeWidgets}" Margin="0,14,0,0">
                    <!-- 面板是 Grid：位置由 code-behind 跑 Axolotl 的 packHomeWidgets 装箱后
                         写进每项的 Grid.Row/Column/RowSpan/ColumnSpan。
                         （之前用 WrapPanel 线性流 —— 装不下就换行，**后面的卡不会回填空洞**，
                           实测 3 列布局里第 3 列整列空着，就是用户看到的「中间空了一大块」。） -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,16,16"/>
                            <EventSetter Event="Loaded" Handler="WidgetItem_Loaded"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}"
                                            ContentTemplateSelector="{StaticResource WidgetTemplateSelector}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

                <!-- ══ 小组件编辑工具条（Axolotl HomeDashboard 底部那条）══
                     只在编辑态出现：＋ 添加 / ↺ 撤销 / ✓ 完成 / ▦ 网格 / ✥ 自由摆放。
                     Axolotl 里它和右下角那颗视图胶囊是同一个位置 —— 编辑态时外壳那颗会隐藏
                     （见 MainWindow.UpdatePillForCurrentPage），所以这里不会重叠。 -->
                <Border Style="{StaticResource iOS26.FloatPill}" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,20,18" Padding="6"
                        Panel.ZIndex="900"
                        Visibility="{Binding IsHomeEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource WidgetDragHandle}" Content="＋" Width="34" Height="34"
                                ToolTip="添加小组件" Click="WidgetToolbarAdd_Click"/>
                        <Button Style="{StaticResource WidgetDragHandle}" Content="&#x21BA;" Width="34" Height="34"
                                ToolTip="撤销上一步" Command="{Binding UndoLayoutCommand}"/>
                        <Button Style="{StaticResource WidgetDragHandle}" Content="&#x2713;" Width="34" Height="34"
                                Margin="6,0,0,0" ToolTip="完成"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                Click="WidgetToolbarDone_Click"/>
                        <Button Style="{StaticResource WidgetDragHandle}" Content="&#x25A6;" Width="34" Height="34"
                                Margin="6,0,0,0" ToolTip="网格布局（自动排列）" Click="WidgetToolbarGrid_Click"/>
                        <Button Style="{StaticResource WidgetDragHandle}" Content="&#x2725;" Width="34" Height="34"
                                ToolTip="自由摆放（可任意拖放）" Click="WidgetToolbarFree_Click"/>
                    </StackPanel>
                </Border>
        </Grid>

        <!-- 右下悬浮胶囊已统一到外壳（MainWindow）的 iOS26.FloatPill：
             一颗胶囊里放 列表 / 网格 / 铅笔 三个圆形按钮，这里不再重复放一颗，避免同角重叠。 -->
    </Grid>
</Page>
