<ui:FluentWindow x:Class="TsuruLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TsuruLauncher"
        xmlns:vm="clr-namespace:TsuruLauncher.ViewModels"
        xmlns:controls="clr-namespace:TsuruLauncher.Controls"
        xmlns:views="clr-namespace:TsuruLauncher.Views"
        xmlns:anim="clr-namespace:TsuruLauncher.Services.Animation"
        xmlns:motion="clr-namespace:TsuruLauncher.Services.Animation"
        mc:Ignorable="d"
        Title="Tsuru Launcher" Height="760" Width="1180" MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:MainWindowNewsIconConverter x:Key="NewsIconConverter"/>

        <!-- ===== Navigation rail button (64px rail: icon over label) =====
             Axolotl NavButton.vue:11 —— transition-all = 150ms cubic-bezier(0.4, 0, 0.2, 1)；
             hover:bg-button-bg + text-contrast；选中态由 NavRail.vue 的滑动胶囊承担
             （.nav-rail :deep(a.router-link-active) { background-color: transparent }）。
             按压缩放沿用 Tabs.vue:12 / FilterPills.vue:39 的 active:scale-[0.97]（100ms）。 -->
        <Style x:Key="NavRailButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <!-- ⚠ 未选中态原来用 TextDimBrush（= 最淡的 T4，本来是给「禁用」用的），
                 浅色模式下和背景几乎同色，导航栏根本看不清。
                 换成 TextSecondary（T2）：两个主题下都清晰，又比选中的强调色弱一档。 -->
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="NavPressScale"/>
                            </Grid.RenderTransform>
                            <Border x:Name="HoverLayer" CornerRadius="{StaticResource RadiusLarge}"
                                    Background="{DynamicResource Surface5Brush}" Opacity="0"/>
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="{StaticResource RadiusLarge}"
                                    Padding="4,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- 文字色按原版切到 color-button-text-selected 令牌；底色交给 NavSlider -->
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavPressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.1"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="NavPressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.1"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavPressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.1"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="NavPressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.1"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Window chrome buttons ===== -->
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface5Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Top bar: icon button (back / forward / bell) ===== -->
        <Style x:Key="TopBarIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface5Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Top bar: outlined capsule button ("reload to update") ===== -->
        <Style x:Key="TopBarOutlinedButton" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGlassLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGlassMediumBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Info panel pieces ===== -->
        <Style x:Key="PanelMiniCard" TargetType="Border" BasedOn="{StaticResource iOS26.CardFlat}">
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="PanelMiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <!-- ⚠ TextDimBrush 是最淡的一层（给「禁用」用的），浅色模式下基本看不清。
                 小标签用 TextTertiary 就够弱了，但还读得出来。 -->
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>

        <Style x:Key="PanelMiniValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 右栏把手改回 Axolotl App.vue:3486-3544 的 .sidebar-toggle-handle 原形态：
             **一个半圆凸耳**（平口贴面板左缘、圆弧朝外），不再是「面板内 24px 圆钮 + 收起态 40px 圆钮」
             两颗互换。外观（24x48 半圆 Border / 面板同色底 + 1px 描边 / 180ms hover 1.12 按下 0.9）
             在 Styles/iOS26.xaml 的 iOS26.PanelLugHandle（§R1-B），MainWindow 只负责摆位与显隐。 -->

        <!-- ===== Floating pill round buttons (grid/list + edit) =====
             Axolotl Tabs.vue:12 / FilterPills.vue:39：
             transition-all duration-100（=100ms cubic-bezier(0.4, 0, 0.2, 1)）+ active:scale-[0.97] -->
        <Style x:Key="FloatPillButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PillPressScale"/>
                            </Grid.RenderTransform>
                            <Border x:Name="HoverLayer" CornerRadius="{StaticResource RadiusXLarge}"
                                    Background="{DynamicResource Surface5Brush}" Opacity="0"/>
                            <Border x:Name="CheckLayer" CornerRadius="{StaticResource RadiusXLarge}"
                                    Background="{DynamicResource AccentGlassMediumBrush}" Opacity="0"/>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusXLarge}">
                                <!-- 图标切换：选中态用 250ms 过冲曲线把图标从 scale(0.7) 弹回 1，
                                     对应 Axolotl FloatingActionBar/App.vue 那条
                                     cubic-bezier(0.15, 1.4, 0.64, 0.96)（原版唯一带过冲的曲线）。 -->
                                <ContentPresenter x:Name="PillContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="PillIconScale"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- ButtonStyled.vue:267-271 background-color / color / filter 0.25s ease-in-out -->
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckLayer" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleX"
                                                             From="0.7" To="1" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.OvershootEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleY"
                                                             From="0.7" To="1" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.OvershootEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CheckLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0"/>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- ButtonStyled.vue:312 active:scale-95（scale 0.125s ease-in-out） -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表 / 网格两态的分段项：选中底色交给 FloatingPill 里的滑动指示块
             （motion:SegmentedIndicator，150ms 单段 TranslateX + Width），本项只保留
             hover 250ms 底色、选中图标 250ms 过冲回弹、按下 scale-95。 -->
        <Style x:Key="HomeSegmentItem" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PillPressScale"/>
                            </Grid.RenderTransform>
                            <Border x:Name="HoverLayer" CornerRadius="{StaticResource RadiusXLarge}"
                                    Background="{DynamicResource Surface5Brush}" Opacity="0"/>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusXLarge}">
                                <ContentPresenter x:Name="PillContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="PillIconScale"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleX"
                                                             From="0.7" To="1" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.OvershootEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleY"
                                                             From="0.7" To="1" Duration="0:0:0.25"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.OvershootEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0"/>
                                            <DoubleAnimation Storyboard.TargetName="PillIconScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="PillPressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.125"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右栏把手（展开 / 收起两种状态同一颗）：贴面板左缘的半圆凸耳，常显可点。
             外观（24x48 半圆 / 面板同色 + 1px 描边 / 180ms hover 1.12 按下 0.9）统一在
             Styles/iOS26.xaml 的 iOS26.PanelLugHandle（§R1-B），
             MainWindow 里只负责摆位、Z 序与「什么时候可见 / 可点」。 -->
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- AdornerDecorator：给整窗提供一个 AdornerLayer。
         MotionAssist.HoverTint 用它叠「卡片 hover 的 250ms 颜色过渡色块」——
         FluentWindow 自己的模板里没有 AdornerDecorator，缺了它 hover 过渡会静默失效。 -->
    <AdornerDecorator>
    <Grid x:Name="RootGrid" Background="{DynamicResource BackgroundBrush}">
        <!-- user background image + scrim (kept only on the outer layer) -->
        <Image Source="{Binding BackgroundImage}"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="{Binding BlurEffectRadius}" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        <Rectangle Fill="{DynamicResource BackgroundBrush}"
                   Opacity="{Binding BackgroundOpacity}"
                   IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== TOP BAR ==================== -->
            <Grid Grid.Row="0" Background="{DynamicResource TopBarBrush}" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="60"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- left: brand + history arrows + current page icon & title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#9935;" FontSize="17" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Tsuru Launcher" FontSize="15" FontWeight="Bold" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Background="{DynamicResource AccentGlassMediumBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}" Padding="6,1" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <!-- 版本号由代码从程序集读取，别再写死（写死过一次：v2.1.0 的包里还显示 v2.0.0） -->
                        <TextBlock x:Name="VersionText" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <Border Width="1" Height="18" Margin="12,0,8,0" VerticalAlignment="Center"
                            Background="{DynamicResource GlassBorderBrush}"/>

                    <Button x:Name="BackButton" Style="{StaticResource TopBarIconButton}"
                            Click="BackButton_Click" ToolTip="后退" IsEnabled="False">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13"/>
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource TopBarIconButton}"
                            Click="ForwardButton_Click" ToolTip="前进" IsEnabled="False">
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13"/>
                    </Button>

                    <ui:SymbolIcon x:Name="PageIcon" Symbol="Home24" FontSize="15" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="PageTitleText" Text="首页" FontSize="13.5" FontWeight="SemiBold" Margin="7,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <TextBlock x:Name="TopBarStatus" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="12,0"/>

                <!-- right: bell + reload + instance state + window chrome -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopBarIconButton}" Click="NotificationsButton_Click" ToolTip="通知">
                        <Grid Width="16" Height="16">
                            <ui:SymbolIcon Symbol="Alert24" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Button>

                    <Border Margin="10,0,4,0" Padding="9,3" VerticalAlignment="Center"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextDimBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="没有运行中的实例"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                                <Setter Property="Text" Value="正在运行"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ChromeButton}" Content="&#8212;" Click="MinimizeButton_Click" ToolTip="最小化"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#9634;" Click="MaximizeButton_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#10005;" Click="CloseButton_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- ==================== BODY ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- 右栏宽度：Axolotl App.vue:3339 的 grid-template-columns: 1fr 右栏宽度变量。
                         直接动画这一列的像素宽度（320ms cubic-bezier(0.22, 1, 0.36, 1)），
                         面板内容保持固定 260px 并被裁切，因此展开/收起不会把内容压扁。 -->
                    <ColumnDefinition x:Name="InfoPanelColumn" Width="268"/>
                </Grid.ColumnDefinitions>

                <!-- navigation rail (64px) -->
                <Border x:Name="NavRailContainer" Grid.Column="0" Width="64"
                        Margin="{StaticResource ShellPanelMarginLeft}"
                        Background="{DynamicResource GlassMediumBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXLarge}">
                    <!-- 整页浮层开关的显隐不再用 DataTrigger 硬切：
                         见 MainWindow.ApplyShellPanels（120ms ease 淡出后才 Collapsed / 180ms ease 淡入）。 -->

                    <Grid x:Name="NavRailHost" ClipToBounds="True">
                        <!-- ===== 滑动指示胶囊（Axolotl NavRail.vue:104-115）=====
                             .nav-rail-slider-transition {
                               top    150ms cubic-bezier(0.4, 0, 0.2, 1) <topDelay>;
                               bottom 150ms cubic-bezier(0.4, 0, 0.2, 1) <bottomDelay>;
                               left   150ms cubic-bezier(0.4, 0, 0.2, 1);
                               width  150ms cubic-bezier(0.4, 0, 0.2, 1);
                               opacity 250ms cubic-bezier(0.5, 0, 0.2, 1) 50ms;
                             }
                             STAGGER_DELAY = 120ms：下滑时 top 延迟（下缘先伸长），上滑时 bottom 延迟。
                             WPF 用 ScaleY（原点在顶边）+ TranslateY 两段合成复刻这个「先拉伸再追上」。 -->
                        <Border x:Name="NavSlider" HorizontalAlignment="Left" VerticalAlignment="Top"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Background="{DynamicResource AccentGlassMediumBrush}"
                                IsHitTestVisible="False" Opacity="0"
                                RenderTransformOrigin="0,0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="NavSliderScale"/>
                                    <TranslateTransform x:Name="NavSliderTranslate"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="NavRail" Margin="6,8,6,8" Panel.ZIndex="1">
                            <RadioButton Style="{StaticResource NavRailButton}" Tag="home" IsChecked="True" Checked="NavRail_Checked" Click="NavRail_Click"
                                         motion:PageAnimation.NavItemIn="True">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Home24" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="首页" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRailButton}" Tag="resources" Checked="NavRail_Checked" Click="NavRail_Click"
                                         motion:PageAnimation.NavItemIn="True">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Library24" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="资源" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRailButton}" Tag="download" Checked="NavRail_Checked" Click="NavRail_Click"
                                         motion:PageAnimation.NavItemIn="True">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="下载" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRailButton}" Tag="skin" Checked="NavRail_Checked" Click="NavRail_Click"
                                         motion:PageAnimation.NavItemIn="True">
                                <StackPanel>
                                    <TextBlock Text="&#128085;" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="皮肤" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRailButton}" Tag="lab" Checked="NavRail_Checked" Click="NavRail_Click"
                                         motion:PageAnimation.NavItemIn="True">
                                <StackPanel>
                                    <TextBlock Text="&#129514;" FontSize="17" HorizontalAlignment="Center"/>
                                    <TextBlock Text="实验室" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavRailButton}" Tag="settings" Checked="NavRail_Checked" Click="NavRail_Click"
                                         motion:PageAnimation.NavItemIn="True">
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="设置" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- page host: 与左右面板同一套圆角 / 外边距 / 半透明底，避免"圆角接直角"的断层 -->
                <Border x:Name="FrameContainer" RenderTransformOrigin="0.5,0.5"
                        Background="{DynamicResource SurfaceContentBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXLarge}" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Margin" Value="{StaticResource ShellPanelMargin}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGlobalResourcesOverlayActive}" Value="True">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <!-- 只吃 0-1 两列：第 2 列是右信息面板，资源页在整页浏览态下仍要保留
                                         （它承载筛选卡片，见 MainWindow.InfoPanelKeptInOverlay）。 -->
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Margin" Value="{StaticResource ShellPanelMarginLeft}"/>
                                    <Setter Property="Panel.ZIndex" Value="1000"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="PageTransitionHost" ClipToBounds="True">
                        <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" Background="Transparent"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                        <!-- ===== 切页两拍重叠（不再是串行淡出）=====
                             不用 RenderTargetBitmap 抓整窗快照（那是切页卡顿的主因）。
                             换页立即发生；宿主 PageTransitionHost 只做一次 1 -> 0.92 -> 1 的
                             回落补偿（100+100ms），与新页 opacity 180ms + translateY 200ms
                             同一帧启动，总时长 200ms（改前是串行 120+200=320ms）。
                             见 MainWindow.RootFrame_Navigated + PageTransition.PlayHostOverlapFade。 -->
                    </Grid>
                </Border>

                <!-- 右下悬浮胶囊（对齐 Axolotl 形态）：列表（极简主页）/ 网格（信息主页）/ 铅笔（自定义 = 编辑小组件） -->
                <Border x:Name="FloatingPill" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="FloatingPill"
                        Margin="0,0,20,18" Panel.ZIndex="900"
                        RenderTransformOrigin="0.5,0.5"
                        motion:PageAnimation.FloatingBarIn="True"
                        Style="{StaticResource iOS26.FloatPill}">
                    <StackPanel Orientation="Horizontal">
                        <!-- 列表 / 网格 = 两态分段控件：选中底色改成滑动指示块 -->
                        <Grid x:Name="HomeViewModeGroup"
                              controls:SegmentedIndicator.Host="True"
                              controls:SegmentedIndicator.Indicator="{Binding ElementName=HomeViewModePill}">
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="HomeViewModePill" CornerRadius="{StaticResource RadiusXLarge}" Opacity="0"
                                        Background="{DynamicResource AccentGlassMediumBrush}"/>
                            </Canvas>
                            <StackPanel Orientation="Horizontal">
                                <!-- R1：切换前预热另一棵主页根 —— hover / 按下就先把目标子树的
                                     measure/arrange 付掉，切换那一帧不再承担首次布局（掉帧来源）。 -->
                                <RadioButton x:Name="HomeListModeButton" Style="{StaticResource HomeSegmentItem}"
                                             GroupName="HomeViewMode"
                                             ToolTip="列表视图（极简主页）" Click="HomeListMode_Click"
                                             MouseEnter="HomeModeButton_PrewarmOnHover"
                                             PreviewMouseDown="HomeModeButton_PrewarmOnPress">
                                    <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="15"/>
                                </RadioButton>
                                <RadioButton x:Name="HomeGridModeButton" Style="{StaticResource HomeSegmentItem}" Margin="4,0,0,0"
                                             GroupName="HomeViewMode"
                                             ToolTip="网格视图（信息主页）" Click="HomeGridMode_Click"
                                             MouseEnter="HomeModeButton_PrewarmOnHover"
                                             PreviewMouseDown="HomeModeButton_PrewarmOnPress">
                                    <ui:SymbolIcon Symbol="GridDots24" FontSize="15"/>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                        <ToggleButton x:Name="HomeEditButton" Style="{StaticResource FloatPillButton}" Margin="4,0,0,0"
                                      ToolTip="自定义（编辑小组件）" Click="HomeEdit_Click"
                                      IsChecked="{Binding IsHomeEditing, Mode=OneWay}">
                            <ui:SymbolIcon Symbol="CalligraphyPen24" FontSize="15"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- ==================== RIGHT INFO PANEL (collapsible) ====================
                     展开 = 260px 面板 + 左缘圆形折角按钮；
                     收起 = 列宽过渡到 0（平滑，不是瞬时切宽度），窗口右边缘另有一条 10px 透明热区，
                     鼠标靠近才浮现 40px 圆形展开按钮。
                     Axolotl App.vue:3376-3380：
                       @media (prefers-reduced-motion: no-preference) {
                         .app-contents { transition: right-bar-width 320ms cubic-bezier(0.22, 1, 0.36, 1); }
                       } -->
                <Border x:Name="InfoPanelHost" Grid.Column="2"
                        Margin="{StaticResource ShellPanelMargin}"
                        Background="Transparent" BorderThickness="0" ClipToBounds="True">
                    <!-- 同上：显隐交给 ApplyShellPanels 做淡出 / 淡入。 -->

                    <Grid>
                        <!-- expanded body：固定 260px 宽 + 左对齐。
                             左对齐（改前是右对齐）：列宽从 268 收到 0 时，面板整体跟着列的左缘一起
                             向右滑出去、被 InfoPanelHost 的 ClipToBounds 裁掉 —— 观众看到的是
                             「面板滑走」，而不是「面板原地被从左边啃掉」。展开时反过来从右边滑进来。
                             宽度恒定 260，内容绝不压扁/重排。 -->
                        <Border x:Name="InfoPanelSurface" Width="260" HorizontalAlignment="Left"
                                Background="{DynamicResource GlassMediumBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusXLarge}" ClipToBounds="True">
                        <!-- 面板左缘不再摆圆形折角按钮：把手是挂在面板**外侧**的那个半圆凸耳
                             （InfoPanelHandleButton，见 BODY 末尾），所以内容吃满 260px。 -->
                        <Grid x:Name="InfoPanelContent" Margin="16,12,14,12">
                            <!-- 两套内容互斥，由 MainWindow.SyncInfoPanelPageContent 按当前页面切换：
                                   * InfoPanelHomeSections —— 首页/其它页：账号 + 游玩洞察 + 每日小挑战 + 新闻
                                   * InfoPanelResourcesFilterHost —— 「资源」页：筛选卡片
                                     （Controls/ResourcesFilterPanel，DataContext = 该页的 ResourcesViewModel） -->
                            <Grid x:Name="InfoPanelHomeSections">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 1. current account -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="当前游玩账号" Style="{StaticResource PanelSectionTitle}"/>
                                <Button x:Name="InfoAccountCard" Style="{StaticResource iOS26.AccountPanelCard}"
                                        AutomationProperties.AutomationId="Q2AccountCard"
                                        AutomationProperties.Name="当前游玩账号"
                                        Click="InfoAccountCard_Click" ToolTip="展开 / 收起账号列表">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                Background="{DynamicResource AccentGlassMediumBrush}">
                                            <ui:SymbolIcon Symbol="Person24" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlayerName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PlayerDetail}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- chevron：收起朝下(0°) / 展开朝上(180°)，150ms 旋转
                                             （MainWindow.AnimateAccountChevron；只动 RenderTransform） -->
                                        <ui:SymbolIcon Grid.Column="2" x:Name="AccountCardChevron" Symbol="ChevronDown24"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       RenderTransformOrigin="0.5,0.5">
                                            <ui:SymbolIcon.RenderTransform>
                                                <RotateTransform x:Name="AccountCardChevronRotate" Angle="0"/>
                                            </ui:SymbolIcon.RenderTransform>
                                        </ui:SymbolIcon>
                                    </Grid>
                                </Button>

                                <!-- 账号面板：在右栏内部原地展开（不是弹到页面上的浮层）。
                                     高度 0 <-> 内容自然高度 + ClipToBounds 裁切，
                                     200ms cubic-bezier(0.22, 1, 0.36, 1)；内容 150ms 淡入淡出；
                                     动画结束由 MainWindow.SettleAccountPanel 强制归位。
                                     形态对齐首页账号浮层：账号列表（头像 + 用户名 + 离线/正版/外置标签
                                     + 「当前」标记 + 复制 / 删除）+ 三行「+ 添加 …」。 -->
                                <Border x:Name="AccountPanelClip" Height="0" Visibility="Collapsed"
                                        ClipToBounds="True"
                                        AutomationProperties.AutomationId="Q2AccountPanel">
                                    <!-- Opacity=0 挂在内容这一层：展开时 150ms 淡入（裁切高度同步长高），
                                         收起时淡出后整块 Collapsed（外层不透明度始终是 1，不然展开后是空白）。 -->
                                    <Border x:Name="AccountPanelInner" Margin="0,8,0,0" Opacity="0"
                                            Style="{StaticResource iOS26.AccountFlyoutSurface}">
                                        <StackPanel>
                                            <TextBlock Text="账号" FontSize="11" FontWeight="SemiBold" Margin="6,2,0,5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>

                                            <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Accounts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource iOS26.AccountPanelRow}"
                                                                    Click="AccountRow_Click" Tag="{Binding}"
                                                                    AutomationProperties.Name="{Binding Username}"
                                                                    ToolTip="切换到该账号">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0" Style="{StaticResource iOS26.AccountAvatar}"
                                                                            Width="26" Height="26" CornerRadius="13">
                                                                        <ui:SymbolIcon Symbol="Person24" FontSize="12"
                                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Username}" FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                            <Border Style="{StaticResource iOS26.AccountTag}" Margin="0">
                                                                                <TextBlock FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Text" Value="离线"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Type}" Value="Microsoft">
                                                                                                    <Setter Property="Text" Value="正版"/>
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding Type}" Value="Yggdrasil">
                                                                                                    <Setter Property="Text" Value="外置"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </Border>
                                                                            <!--「当前」标记：IsCurrent 由 MainViewModel.RefreshCurrentAccountFlags 维护 -->
                                                                            <Border Style="{StaticResource iOS26.AccountTagCurrent}"
                                                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock Text="当前" FontSize="9.5"
                                                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource iOS26.AccountPanelIconButton}"
                                                                                Click="CopyAccount_Click" Tag="{Binding}"
                                                                                ToolTip="复制用户名" AutomationProperties.Name="复制用户名">
                                                                            <ui:SymbolIcon Symbol="Copy24" FontSize="12"/>
                                                                        </Button>
                                                                        <Button Style="{StaticResource iOS26.AccountPanelIconButton}"
                                                                                Click="DeleteAccount_Click" Tag="{Binding}"
                                                                                ToolTip="删除账号" AutomationProperties.Name="删除账号">
                                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="12"
                                                                                           Foreground="{DynamicResource DangerBrush}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock Text="还没有添加任何账号" FontSize="11" Margin="6,4,6,8"
                                                       Foreground="{DynamicResource TextDimBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Rectangle Height="1" Margin="6,2,6,4" Fill="{DynamicResource GlassBorderBrush}"/>

                                            <Button Style="{StaticResource iOS26.AccountPanelAddRow}" Click="AddMicrosoftAccount_Click"
                                                    AutomationProperties.AutomationId="Q2AddMicrosoft"
                                                    AutomationProperties.Name="添加 Microsoft 账户" ToolTip="添加 Microsoft 账户">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="添加 Microsoft 账户" FontSize="12" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource iOS26.AccountPanelAddRow}" Click="AddYggdrasilAccount_Click"
                                                    AutomationProperties.AutomationId="Q2AddYggdrasil"
                                                    AutomationProperties.Name="添加第三方账号" ToolTip="添加第三方账号（外置登录）">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="添加第三方账号" FontSize="12" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource iOS26.AccountPanelAddRow}" Click="AddOfflineAccount_Click"
                                                    AutomationProperties.AutomationId="Q2AddOffline"
                                                    AutomationProperties.Name="添加离线账户" ToolTip="添加离线账户">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="添加离线账户" FontSize="12" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <!-- 2. play insights -->
                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                <TextBlock Text="游玩洞察" Style="{StaticResource PanelSectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelMiniCard}">
                                        <StackPanel>
                                            <TextBlock Text="游玩时长" Style="{StaticResource PanelMiniLabel}"/>
                                            <TextBlock Text="{Binding PlayTimeText}" Style="{StaticResource PanelMiniValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelMiniCard}">
                                        <StackPanel>
                                            <TextBlock Text="启动次数" Style="{StaticResource PanelMiniLabel}"/>
                                            <TextBlock Text="{Binding LaunchCountText}" Style="{StaticResource PanelMiniValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelMiniCard}">
                                        <StackPanel>
                                            <TextBlock Text="版本数" Style="{StaticResource PanelMiniLabel}"/>
                                            <TextBlock Text="{Binding VersionCountText}" Style="{StaticResource PanelMiniValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelMiniCard}">
                                        <StackPanel>
                                            <TextBlock Text="模组数" Style="{StaticResource PanelMiniLabel}"/>
                                            <TextBlock Text="{Binding ModCountText}" Style="{StaticResource PanelMiniValue}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 3. daily challenge -->
                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Text="每日小挑战" Style="{StaticResource PanelSectionTitle}"/>
                                <Border Style="{StaticResource iOS26.CardFlat}" Background="{DynamicResource Surface3Brush}"
                                        Padding="11,10">
                                    <StackPanel>
                                        <TextBlock Text="只用石制工具，撑过游戏里的第一夜。" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="先不放床，看看天亮时还能剩多少经验。" FontSize="10.5" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Border Style="{StaticResource iOS26.TagPill}">
                                                <TextBlock Text="生存" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource iOS26.TagPill}">
                                                <TextBlock Text="中等" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </Border>
                                            <Ellipse Width="7" Height="7" Margin="4,0,0,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentBrush}"/>
                                            <Ellipse Width="7" Height="7" Margin="5,0,0,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentBrush}"/>
                                            <Ellipse Width="7" Height="7" Margin="5,0,0,0" VerticalAlignment="Center"
                                                     Fill="{DynamicResource Surface5Brush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 4. news feed -->
                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Minecraft 新闻" VerticalAlignment="Center"
                                               Style="{StaticResource PanelSectionTitle}" Margin="0"/>
                                    <Border Grid.Column="1" Style="{StaticResource iOS26.TagPill}" Margin="0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NewsItems.Count}" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Border>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding NewsItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource iOS26.CardFlat}"
                                                        Background="{DynamicResource Surface3Brush}"
                                                        Padding="9,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                                                Background="{DynamicResource AccentGlassLightBrush}">
                                                            <ui:SymbolIcon
                                                                Symbol="{Binding Icon, Converter={StaticResource NewsIconConverter}}"
                                                                FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                            </Grid>

                            <!-- 「资源」页：筛选卡片宿主。内容由 MainWindow.SyncInfoPanelPageContent
                                 在导航时注入（复用同一个 ResourcesFilterPanel 实例，
                                 DataContext 指向该页的 ResourcesViewModel）。 -->
                            <ContentControl x:Name="InfoPanelResourcesFilterHost" Visibility="Collapsed"/>

                            <!-- 「版本选择」页：右栏放文件夹列表（原来它挤在版本列表左边一列，
                                 还要靠标题栏的 📂 按钮切换，观感很别扭 —— 现在整块搬过来，按钮删掉）。 -->
                            <ContentControl x:Name="InfoPanelFolderListHost" Visibility="Collapsed"/>

                            <!-- 「资源详情」页：右栏 = 兼容性 / 相关链接 / 标签 / 作者 / 信息
                                 （Axolotl 也是放这里，不是页面内部） -->
                            <ContentControl x:Name="InfoPanelResourceDetailHost" Visibility="Collapsed"/>

                            <!-- 首页「编辑小组件」态：右栏换成小组件编辑器。
                                 之前「添加小组件」是直接铺在网格视图上的一个内联框 —— 用户反馈
                                 「添加小组件只适用于网格视图，不要显示在网格视图上，应该放右栏」，
                                 所以整块搬到这里；网格视图上只保留每张卡的小按钮。 -->
                            <ScrollViewer x:Name="InfoPanelWidgetEditorHost" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="编辑小组件" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding WidgetCountText}" FontSize="11" Margin="0,3,0,14"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>

                                    <TextBlock Text="已启用" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding ActiveWidgets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9"
                                                        Padding="9,7" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SizeKey}" FontSize="10" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="&#8646;" Width="24" Height="24" FontSize="11"
                                                                    Cursor="Hand" ToolTip="切换尺寸"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                                    Command="{Binding DataContext.CycleWidgetSizeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="&#10005;" Width="24" Height="24" FontSize="11"
                                                                    Margin="2,0,0,0" Cursor="Hand" ToolTip="移除"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                                    Command="{Binding DataContext.RemoveWidgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="可添加" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,6"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding AddableWidgetKinds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" HorizontalContentAlignment="Left" Padding="9,7"
                                                        Margin="0,0,0,4" BorderThickness="1"
                                                        Background="{DynamicResource Surface2Brush}"
                                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        Command="{Binding DataContext.AddWidgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Kind}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" Margin="7,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,12,0,10"/>
                                    <Button Content="重置布局" Height="30" Cursor="Hand" Margin="0,0,0,6"
                                            Command="{Binding ResetWidgetsCommand}"
                                            Style="{StaticResource iOS26.SecondaryButton}"/>
                                    <Button Content="紧凑模式" Height="30" Cursor="Hand" Margin="0,0,0,6"
                                            Command="{Binding ToggleCompactCommand}"
                                            Style="{StaticResource iOS26.SecondaryButton}"/>
                                    <Button Content="完成" Height="32" Cursor="Hand" Margin="0,4,0,0"
                                            Command="{Binding ToggleHomeEditCommand}"
                                            Style="{StaticResource iOS26.CapsuleButtonBrand}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ R1：右栏展开 / 折叠把手 —— 一个「半圆凸耳」══════════════════════════════════
                     Axolotl App.vue:3486-3544 .sidebar-toggle-handle 原值：
                         position:absolute; top:50%; left:-15px; transform:translateY(-50%); z-index:12;
                         width:15px; height:40px; border-radius:12px 0 0 12px; border-right:none;
                     → 凸耳平口贴住「面板左缘」，圆弧朝面板**外侧**鼓出。
                     为什么只留一个元素：面板左缘 = 本列（InfoPanelColumn）的左缘。列宽 268 <-> 0 的
                     320ms 过渡会把这条边从面板位置一路推到窗口右缘，于是**同一个凸耳**在收起态自然
                     就是「贴右缘、垂直居中」——不需要展开态 / 收起态两颗把手互换，收起过程中也不会
                     出现「把手跳位」。Axolotl 把 right-bar-width 这个变量收到 0px 时就是这个效果。
                     摆位：HorizontalAlignment=Left + Margin=-40（按钮 40px 宽，可见凸耳 24px 在按钮内
                     靠右对齐）→ 凸耳右缘正好压在面板左缘上，往页面方向凸出 24px。
                     可点区域：40 x 48（可见 24 + 不可见 padding 16，全部落在面板外侧，不挡面板内容）。
                     Z 序：1300 —— 高于页面宿主(1000) / 悬浮胶囊(900) / 下面这条边缘热区(1200)；
                           热区与凸耳同属本 Grid，所以命中测试能稳定分给凸耳（SyncInfoPanelEdge 里
                           每轮还会用 VisualTreeHelper.HitTest 实测复核一次最上层元素是不是凸耳）。 -->
                <Border x:Name="InfoPanelEdgeStrip" Grid.Column="2"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Width="24" Background="Transparent" Panel.ZIndex="1200"
                        MouseLeftButtonUp="InfoPanelEdge_Click"/>

                <Button x:Name="InfoPanelHandleButton" Grid.Column="2"
                        Style="{StaticResource iOS26.PanelLugHandle}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="-40,0,0,0" Panel.ZIndex="1300"
                        AutomationProperties.AutomationId="Q2PanelHandle"
                        AutomationProperties.Name="展开 / 收起信息面板"
                        Click="InfoPanelHandle_Click" ToolTip="展开 / 收起信息面板">
                    <ui:SymbolIcon x:Name="InfoPanelHandleIcon" Symbol="ChevronRight24" FontSize="13"/>
                </Button>
            </Grid>
        </Grid>

        <!-- notifications -->
        <StackPanel x:Name="NotificationContainer"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,68,0,0"
                    Panel.ZIndex="2000"
                    Width="400"/>

        <views:DownloadManagerPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Panel.ZIndex="1000"/>

        <!-- preload toast -->
        <Grid x:Name="PreloadNotification" Panel.ZIndex="3000"
              VerticalAlignment="Bottom" HorizontalAlignment="Right"
              Margin="0,0,24,24"
              Visibility="Collapsed"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Border CornerRadius="{StaticResource RadiusLarge}" Background="{DynamicResource PopoverBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="16,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PreloadNotifIcon" Width="24" Height="24" CornerRadius="{StaticResource RadiusSmall}"
                            Background="{DynamicResource AccentGlassMediumBrush}" Margin="0,0,10,0">
                        <TextBlock x:Name="PreloadNotifIconText" Text="&#8987;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PreloadNotifTitle" Text="正在预加载资源..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PreloadNotifDetail" Text="" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <ProgressBar x:Name="PreloadNotifProgress" Width="60" Height="3" Background="{DynamicResource Surface5Brush}" Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0" VerticalAlignment="Center" Margin="12,0,0,0" Maximum="100" Minimum="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </AdornerDecorator>
</ui:FluentWindow>
