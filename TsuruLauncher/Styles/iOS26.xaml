<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:anim="clr-namespace:TsuruLauncher.Services.Animation"
                    xmlns:motion="clr-namespace:TsuruLauncher.Services.Animation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ========== iOS26 DEPRECATED KEYS (forward to new unified keys) ========== -->
    <SolidColorBrush x:Key="iOS26.Background" Color="#40000000" po:Freeze="False"/>
    <SolidColorBrush x:Key="iOS26.SidebarLayer" Color="#4D0C110F" po:Freeze="False"/>
    <SolidColorBrush x:Key="iOS26.ContentLayer" Color="#F0141B18" po:Freeze="False"/>
    <SolidColorBrush x:Key="iOS26.FloatingLayer" Color="#F01A221E" po:Freeze="False"/>
    <SolidColorBrush x:Key="iOS26.CardLayer" Color="#30FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="iOS26.Accent" Color="#55C244" po:Freeze="False"/>
    <SolidColorBrush x:Key="iOS26.AccentHover" Color="#6FD35C" po:Freeze="False"/>
    <SolidColorBrush x:Key="iOS26.AccentDim" Color="#3F9B32" po:Freeze="False"/>
    <CornerRadius x:Key="iOS26.CornerRadius.XLarge">24</CornerRadius>
    <CornerRadius x:Key="iOS26.CornerRadius.Large">16</CornerRadius>
    <CornerRadius x:Key="iOS26.CornerRadius.Medium">12</CornerRadius>
    <CornerRadius x:Key="iOS26.CornerRadius.Small">8</CornerRadius>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="30" ShadowDepth="4" Opacity="0.3" Color="Black"/>

    <!-- ========== OPTIMIZED GLASS STYLES ========== -->

    <!-- Core Glass Card - layered acrylic effect -->
    <Style x:Key="iOS26.GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Glass Card with subtle top highlight for depth -->
    <Style x:Key="iOS26.GlassCardHighlight" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Input-style Glass Card (darker, for forms) -->
    <Style x:Key="iOS26.GlassCardInput" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Hover Glass Card：颜色过渡 + Axolotl 的 active:scale-[0.98] 按压反馈。
         颜色全部来自主题画笔（DynamicResource），不再写死 #40FFFFFF 这类字面色值。 -->
    <Style x:Key="iOS26.AnimatedCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="20"/>
        <!-- Axolotl 卡片按压反馈：Instance.vue:272 / GridDisplay.vue:530 active:scale-[0.98]，
         transition-[border-color,filter,transform] = 150ms cubic-bezier(0.4, 0, 0.2, 1)。
         只动 RenderTransform 的 ScaleTransform，不动 Width/Height/Margin。 -->
        <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
        <!-- hover 颜色不再用 Trigger 瞬时换 Background（Axolotl 是 background-color 0.25s ease-in-out，
             见 ButtonStyled.vue:267-271 / InstanceRowCard.vue:15），改成 AdornerLayer 上叠一层
             同圆角色块、动它的 Opacity —— 冻结的 DynamicResource 画刷不能动 Color，
             这样既能保留 DynamicResource，又能拿到真正的 250ms 平滑过渡。 -->
        <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource GlassHeavyBrush}"/>
        <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
        <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
            </Trigger>
</Style.Triggers>
    </Style>

    <!-- List Item Card：颜色过渡 + active:scale-[0.98]（Axolotl InstanceRowCard.vue:15 / Instance.vue:272） -->
    <Style x:Key="iOS26.ListItemCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Axolotl 卡片按压反馈：Instance.vue:272 / GridDisplay.vue:530 active:scale-[0.98]，
         transition-[border-color,filter,transform] = 150ms cubic-bezier(0.4, 0, 0.2, 1)。
         只动 RenderTransform 的 ScaleTransform，不动 Width/Height/Margin。 -->
        <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
        <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource GlassMediumBrush}"/>
        <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
        <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
            </Trigger>
</Style.Triggers>
    </Style>

    <!-- Hover Card：悬停换 Background / BorderBrush + active:scale-[0.98] -->
    <Style x:Key="iOS26.HoverCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Axolotl 卡片按压反馈：Instance.vue:272 / GridDisplay.vue:530 active:scale-[0.98]，
         transition-[border-color,filter,transform] = 150ms cubic-bezier(0.4, 0, 0.2, 1)。
         只动 RenderTransform 的 ScaleTransform，不动 Width/Height/Margin。 -->
        <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
        <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface3Brush}"/>
        <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
        <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
            </Trigger>
</Style.Triggers>
    </Style>

    <!-- Card Style (Content Layer) -->
    <Style x:Key="iOS26.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
    </Style>

    <!-- ========== BUTTON STYLES ========== -->

    <!-- Hero Button -->
    <Style x:Key="HeroButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="80"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0.4"/>
                    <GradientStop Color="{DynamicResource AccentDimColor}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusXLarge}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ButtonScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="0.97" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="0.97" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="iOS26.SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BtnScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassHeavyBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="0.95" Duration="0:0:0.125"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="0.95" Duration="0:0:0.125"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Capsule Button -->
    <Style x:Key="iOS26.CapsuleButton" TargetType="Button">
        <Setter Property="Height" Value="45"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CapsuleScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassStrongBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.25" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassHeavyBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="0.95" Duration="0:0:0.125"/>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="0.95" Duration="0:0:0.125"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="CapsuleScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Jelly Button -->
    <Style x:Key="iOS26.JellyButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="JellyScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="JellyScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="0.97" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="JellyScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="0.97" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="JellyScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="JellyScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Download Button -->
    <Style x:Key="iOS26.DownloadButton" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="DlScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGlassLightBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5055C244"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGlassStrongBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DlScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="0.95" Duration="0:0:0.125"/>
                                        <DoubleAnimation Storyboard.TargetName="DlScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="0.95" Duration="0:0:0.125"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DlScale"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="DlScale"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       To="1.0" Duration="0:0:0.125" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== SEGMENT RADIO BUTTON ==========
         选中底色不再由本项自己画（旧实现是 CheckLayer 透明度硬切）：
         容器里挂 seg:SegmentedIndicator 的滑动指示块承担，项只做 150ms 的
         「双层文字交叉淡入」（WPF 没法对冻结的主题画刷做 Color 动画）。 -->
    <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <!-- 悬停底色一层（只给未选中项用，选中的那项要让滑动胶囊露出来） -->
                        <Border x:Name="HoverLayer"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Background="{DynamicResource GlassLightBrush}" Opacity="0"/>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter x:Name="TextNormal"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                TextElement.FontWeight="SemiBold"/>
                                <ContentPresenter x:Name="TextAccent" Opacity="0" IsHitTestVisible="False"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                TextElement.Foreground="{DynamicResource AccentForegroundBrush}"
                                                TextElement.FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                       To="0" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                       To="1" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                       To="1" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                       To="0" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                       To="1" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                       To="0" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== SETTINGS STYLES ========== -->
    <Style x:Key="iOS26.SettingsGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="iOS26.SettingsItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassLightBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="iOS26.SettingsItem.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="iOS26.SettingsItem.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <Style x:Key="iOS26.SettingsSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="16,0,0,8"/>
    </Style>

    <!-- ========== FORM CONTROL STYLES ========== -->

    <!-- Glass Slider -->
    <Style x:Key="iOS26.GlassSlider" TargetType="Slider">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="0.01"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="TrackFill"
                                                    Height="6"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="{DynamicResource AccentDimColor}" Offset="0"/>
                                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Width="22"
                                       Height="22"
                                       VerticalAlignment="Center">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="{DynamicResource AccentForegroundBrush}"
                                                    CornerRadius="11"
                                                    Width="22"
                                                    Height="22"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="ThumbScale"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleX"
                                                                               To="1.12" Duration="0:0:0.18" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleY"
                                                                               To="1.12" Duration="0:0:0.18" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleX"
                                                                               To="1.0" Duration="0:0:0.18"/>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleY"
                                                                               To="1.0" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#F0F0F0"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleX"
                                                                               To="0.9" Duration="0:0:0.18"/>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleY"
                                                                               To="0.9" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleX"
                                                                               To="1.0" Duration="0:0:0.18" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                               Storyboard.TargetProperty="ScaleY"
                                                                               To="1.0" Duration="0:0:0.18" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="TrackBackground"
                                                    Height="6"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource GlassLightBrush}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass TextBox -->
    <Style x:Key="iOS26.GlassTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="#40141B18"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#50FFFFFF"/>
                            <Setter TargetName="border" Property="Background" Value="#3D141B18"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass ComboBox -->
    <Style x:Key="iOS26.GlassComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10,32,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- ⚠ 必须同时绑 ContentTemplate，否则 ComboBox 选中项走 ToString()，
                                     界面上会显示 "TsuruLauncher.Models.Ecosystem.ModFile" 这种类型名
                                     （实测：资源详情页的版本下拉就是这个毛病）。 -->
                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Path Grid.Column="1"
                                      Data="M0 0 L4 5 L8 0 Z"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Width="9" Height="5"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Stretch="Uniform"
                                      x:Name="arrow"/>
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="toggleBtn"
                                       IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                       Opacity="0"
                                       Focusable="False"
                                       ClickMode="Press"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Slide">
                            <Border x:Name="dropDownBorder"
                                    Background="{DynamicResource SurfaceDropdownBrush}"
                                    BorderBrush="{DynamicResource GlassBorderHoverBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Padding="4">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#50FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="2,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentGlassMediumBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <!-- Glass ProgressBar -->
    <Style x:Key="iOS26.GlassProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource GlassLightBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Height="{TemplateBinding Height}"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Height="{TemplateBinding Height}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource AccentDimColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search Box -->
    <Style x:Key="iOS26.SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource GlassLightBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x1F50D;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.5"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource GlassMediumBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource GlassMediumBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== TYPOGRAPHY ========== -->
    <Style x:Key="iOS26.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="iOS26.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,30"/>
    </Style>

    <!-- ========== NOTIFICATION ========== -->
    <Style x:Key="iOS26.GlassNotification" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface5Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
    </Style>

    <!-- Fade In Text -->
    <Style x:Key="iOS26.FadeInText" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0" To="1" Duration="0:0:0.18" EasingFunction="{x:Static anim:AxolotlMotion.EaseOut}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         ===== SHARED CONTROL KIT (shell + reusable page controls) =====
         Every colour is a theme brush (DynamicResource) so the runtime
         theme picker re-colours these controls; no literal colours.
         ============================================================ -->

    <!-- Primary action: solid accent capsule (radius 20), hover lightens -->
    <Style x:Key="iOS26.CapsuleButtonBrand" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Axolotl ButtonStyled.vue:267-271/312 —— scale 0.125s ease-in-out + active:scale-95 -->
        <Setter Property="motion:MotionAssist.PressScale" Value="0.95"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="125"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
    </Style>

    <!-- Segmented control container (host for iOS26.SegmentItem radios) -->
    <Style x:Key="iOS26.Segmented" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- One segment inside iOS26.Segmented.
         选中胶囊（solid accent）由容器里的 seg:SegmentedIndicator 指示块承担，
         本项只做 150ms 的「双层文字交叉淡入」。 -->
    <Style x:Key="iOS26.SegmentItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter x:Name="TextNormal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontWeight="SemiBold"/>
                            <ContentPresenter x:Name="TextAccent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Opacity="0" IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource AccentForegroundBrush}"
                                              TextElement.FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface4Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Axolotl Tabs.vue:12 / FilterPills.vue:39 —— duration-100 + active:scale-[0.97] -->
        <Setter Property="motion:MotionAssist.PressScale" Value="0.97"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="100"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
    </Style>

    <!-- Small gray tag pill (loader / version / category) -->
    <Style x:Key="iOS26.TagPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Flat card: radius 12, 1px stroke, no shadow；悬停只提亮描边（无缩放） -->
    <Style x:Key="iOS26.CardFlat" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Floating capsule that hovers over the content (bottom-right) -->
    <Style x:Key="iOS26.FloatPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceFloatingBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ========== SHELL PANEL TOKENS (导航栏 / 内容宿主 / 右侧信息面板共用) ========== -->

    <!-- 外壳三块面板统一的外边距：与顶栏对齐（顶栏之下，四周留 8px 让壁纸+遮罩透进来） -->
    <Thickness x:Key="ShellPanelMargin">0,0,8,8</Thickness>
    <Thickness x:Key="ShellPanelMarginLeft">8,0,8,8</Thickness>

    <!-- 圆形按钮半径 token：40px 直径的圆 = 20（32px 圆用 RadiusXLarge 16，24px 圆用 RadiusLarge 12） -->
    <CornerRadius x:Key="RadiusCircle40">20</CornerRadius>


    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         §S1-A  右侧信息面板：贴右边缘的圆形把手（折叠态「展开」按钮）
         Axolotl App.vue:3486-3544 折角手柄原值：
             transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
             :hover svg { transform: scale(1.12) }   :active svg { transform: scale(0.9) }
             svg { transition: transform 180ms ease }
         落地方式：整颗 40px 的圆就是可点区域（满足「可点击区域 ≥ 40px」），
         1.12 / 0.9 直接做在这颗圆上（MotionAssist.HoverScale / PressScale，只动 ScaleTransform，
         不碰 Width / Height / Margin，因此点击与悬停都不会触发布局 → 同步阻塞 ≈ 0）。
         ============================================================================================= -->
    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         §S1-B  账号下拉浮层（Axolotl 账号卡的展开面板）
         形态：账号列表（当前账号 + 离线/正版标签 + 复制 / 删除）+ 三行「+ 添加 …」。
         过渡由 HomePage/PageTransition.PlayPopup 负责：
             展开 250ms cubic-bezier(0.15, 1.4, 0.64, 0.96)，scale 0.96 -> 1 + translateY 4px + opacity
             收起 150ms ease
         这里只给外观（颜色一律 DynamicResource，跟随主题 / 强调色）。
         ============================================================================================= -->
    <Style x:Key="iOS26.AccountFlyoutSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceDropdownBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 账号行 / 添加行：hover 用 AdornerLayer 上的 250ms 色块过渡，保留 DynamicResource 画刷 -->
    <Style x:Key="iOS26.AccountRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="2,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
        <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
        <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.6"/>
        <Setter Property="motion:MotionAssist.HoverTintRadius" Value="14"/>
    </Style>

    <Style x:Key="iOS26.AccountAddRow" TargetType="Border" BasedOn="{StaticResource iOS26.AccountRow}">
        <Setter Property="Padding" Value="10,9"/>
    </Style>

    <!-- 行内的复制 / 删除小圆钮（28px），只动 ScaleTransform -->
    <Style x:Key="iOS26.AccountIconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="motion:MotionAssist.HoverScale" Value="1.12"/>
        <Setter Property="motion:MotionAssist.HoverScaleMs" Value="180"/>
        <Setter Property="motion:MotionAssist.HoverScaleEase" Value="Ease"/>
        <Setter Property="motion:MotionAssist.PressScale" Value="0.9"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="180"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="Ease"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="{StaticResource RadiusLarge}" Background="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface5Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 账号类型标签（正版 / 离线 / 外置登录 / 当前） -->
    <Style x:Key="iOS26.AccountTag" TargetType="Border" BasedOn="{StaticResource iOS26.TagPill}">
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 「当前」标签：强调色底 -->
    <Style x:Key="iOS26.AccountTagCurrent" TargetType="Border" BasedOn="{StaticResource iOS26.AccountTag}">
        <Setter Property="Background" Value="{DynamicResource AccentGlassMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>

    <!-- 30px 圆形按钮的半径 token（账号头像用；StaticResource 按解析顺序解析，必须先声明） -->
    <CornerRadius x:Key="RadiusCircle30">15</CornerRadius>

    <!-- 账号下拉浮层里的账号头像（首字母圆） -->
    <Style x:Key="iOS26.AccountAvatar" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCircle30}"/>
        <Setter Property="Background" Value="{DynamicResource AccentGlassLightBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 首页「当前账号」胶囊：点开账号下拉浮层。
         按压 scale 0.98 / 150ms（Axolotl Instance.vue:272 active:scale-[0.98]），
         hover 用 250ms 色块过渡（同卡片那一组），只动 ScaleTransform / Opacity。 -->
    <Style x:Key="iOS26.AccountCapsule" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
        <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
        <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
        <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.55"/>
        <Setter Property="motion:MotionAssist.HoverTintRadius" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="12,10" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         §Q2  右栏「当前游玩账号」卡片 + 面板内原地展开的账号面板
         形态（对齐 Axolotl 账号卡 / 首页账号浮层）：点卡片在右栏内部原地展开
             账号列表（头像 + 用户名 + 离线/正版/外置 标签 + 「当前」标记 + 复制 / 删除）
             + 三行「+ 添加 …」；卡片右侧 chevron 展开朝上 / 收起朝下。
         过渡由 MainWindow.ApplyAccountPanel 播：
             chevron 150ms 旋转 / 高度 200ms cubic-bezier(0.22, 1, 0.36, 1) / 内容 150ms 淡入淡出，
             动画结束强制归位（清时钟 + 写终态）。
         这一层只给外观：颜色一律 DynamicResource（跟随主题 / 强调色），
         动效只走 MotionAssist 的 ScaleTransform / Opacity（不碰 Width / Height / Margin，
         因此悬停与按压不会触发布局 → 点击路径同步阻塞 ≈ 0）。
         ============================================================================================= -->

    <!-- 账号卡：可点（整张卡就是按钮），外观等同 iOS26.CardFlat + 悬停提亮描边 -->
    <Style x:Key="iOS26.AccountPanelCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="11,10"/>
        <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
        <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
        <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
        <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.45"/>
        <Setter Property="motion:MotionAssist.HoverTintRadius" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 面板内的账号行：透明底 + 250ms 色块过渡（同 iOS26.AccountRow，但行本体是 Button 以便 UIA 调用） -->
    <Style x:Key="iOS26.AccountPanelRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
        <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
        <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.6"/>
        <Setter Property="motion:MotionAssist.HoverTintRadius" Value="12"/>
        <Setter Property="motion:MotionAssist.PressScale" Value="0.98"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="150"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="EaseInOut"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 三行「+ 添加 …」：同一形态，行高略高一点 -->
    <Style x:Key="iOS26.AccountPanelAddRow" TargetType="Button" BasedOn="{StaticResource iOS26.AccountPanelRow}">
        <Setter Property="Padding" Value="8,7"/>
    </Style>

    <!-- 行内的复制 / 删除小圆钮（24px；面板内容区只有 ~214px，比首页浮层的 28px 再收一点），只动 ScaleTransform -->
    <Style x:Key="iOS26.AccountPanelIconButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="motion:MotionAssist.HoverScale" Value="1.12"/>
        <Setter Property="motion:MotionAssist.HoverScaleMs" Value="180"/>
        <Setter Property="motion:MotionAssist.HoverScaleEase" Value="Ease"/>
        <Setter Property="motion:MotionAssist.PressScale" Value="0.9"/>
        <Setter Property="motion:MotionAssist.PressScaleMs" Value="180"/>
        <Setter Property="motion:MotionAssist.PressScaleEase" Value="Ease"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="{StaticResource RadiusLarge}" Background="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface5Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         §R1-B  右侧信息面板把手：**半圆凸耳**（Axolotl App.vue:3486-3544 .sidebar-toggle-handle 原值）

             .sidebar-toggle-handle {
               position: absolute; top: 50%; left: -15px; transform: translateY(-50%); z-index: 12;
               width: 15px; height: 40px;
               border: 1px solid var(handle-border); border-right: none;
               border-radius: 12px 0 0 12px;      // 只圆外侧(左)，右缘与 Sidebar 完全贴合
               background-color: var(handle-bg); // brand 12% 混 bg ≈ 面板同色
             // 注：上面两个 CSS 自定义属性在原文件里带两道横线前缀；XML 注释不允许出现连续的
             //     '-'，所以这里省掉前缀，属性名本体不变。
               transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
             }
             .sidebar-toggle-handle:hover svg  { transform: scale(1.12) }
             .sidebar-toggle-handle:active svg { transform: scale(0.9)   }
             svg { transition: transform 180ms ease }

         落地（用户要求「用 Border 做出半圆凸耳」，不是圆按钮）：
           * 形状：24 x 48 的 Border + CornerRadius="24,0,0,24" —— 左边两个圆角半径 24+24 = 48
             正好等于高度，合起来就是一个**标准半圆**；右侧两角为 0，平口贴住面板左缘。
           * 可点区域：按钮 40 x 48。可见凸耳 24px 在按钮内右对齐，左侧 16px 是不可见 padding，
             满足「可点区域 ≥ 40px（含不可见 padding）」，而且 padding 全部落在面板**外侧**
             （按钮整体贴在面板左边），既不侵占面板内容，也不会挡住面板里的点击。
           * 180ms hover 1.12 / 按下 0.9 挂在凸耳 Border 自己身上（= Axolotl 的 svg scale），
             走 MotionAssist 的 ScaleTransform，不碰 Width/Height/Margin，同步阻塞 ≈ 0；
             结束态由 HoldEnd 保持，不需要额外归位。
           * 颜色一律 DynamicResource：底色取面板同一枚 GlassMediumBrush（「背景用面板同色」），
             1px 描边 GlassBorderBrush，hover / 按下切 AccentGlassMediumBrush + AccentBorderBrush，
             主题与强调色切换自动跟随。
         ============================================================================================= -->
    <Style x:Key="iOS26.PanelLugHandle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 透明 Grid 撑满 40x48：不可见 padding 也要能命中（Border 的 Background 为空时不可命中） -->
                    <Grid Background="Transparent">
                        <!-- 凸耳本体：右缘平口（贴面板左缘），左缘半圆（朝面板外侧鼓出） -->
                        <Border x:Name="Lug" Width="24" Height="48" HorizontalAlignment="Right"
                                Background="{DynamicResource GlassMediumBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="24,0,0,24"
                                motion:MotionAssist.HoverScale="1.12"
                                motion:MotionAssist.HoverScaleMs="180"
                                motion:MotionAssist.HoverScaleEase="Ease"
                                motion:MotionAssist.PressScale="0.9"
                                motion:MotionAssist.PressScaleMs="180"
                                motion:MotionAssist.PressScaleEase="Ease">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lug" Property="Background" Value="{DynamicResource AccentGlassMediumBrush}"/>
                            <Setter TargetName="Lug" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Lug" Property="Background" Value="{DynamicResource AccentGlassMediumBrush}"/>
                            <Setter TargetName="Lug" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
