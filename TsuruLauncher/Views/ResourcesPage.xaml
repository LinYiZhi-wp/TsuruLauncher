<Page x:Class="TsuruLauncher.Views.ResourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:TsuruLauncher.Services.Animation"
        xmlns:motion="clr-namespace:TsuruLauncher.Services.Animation"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TsuruLauncher.ViewModels"
      xmlns:conv="clr-namespace:TsuruLauncher.Converters"
      xmlns:seg="clr-namespace:TsuruLauncher.Controls"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1180"
      Title="Resources"
      Background="Transparent"
      PreviewMouseWheel="Page_PreviewMouseWheel">

    <Page.DataContext>
        <vm:ResourcesViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:CategoryNameConverter x:Key="CategoryNameConverter"/>
        <conv:StringMatchToBoolConverter x:Key="StringMatchToBoolConverter"/>
        <conv:DownloadCountConverter x:Key="DownloadCountConverter"/>

        <Storyboard x:Key="SkeletonPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.7" Duration="0:0:2" AutoReverse="True" EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
        </Storyboard>

        <!-- 侧栏分类项（Axolotl NavRail.vue:11,82-87,104-115 的 WPF 落地）
             选中态底色交给滑动指示块 CategoryIndicator（对齐原版
             .nav-rail :deep(a.router-link-active) { background-color: transparent }），
             所以本项自己不再换底色。
             hover 底色 150ms cubic-bezier(0.4,0,0.2,1) 淡入淡出；
             选中态前景色用「两层文字交叉淡入」做真正的 150ms 颜色过渡
             （WPF 没法给冻结的主题画刷做 Color 动画，见 AXOLOTL_MOTION_PARAMS.md 已知取舍 1）。 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource Surface4Brush}"/>
                            <Grid Margin="10,8">
                                <ContentPresenter x:Name="TextNormal" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ContentPresenter x:Name="TextAccent" VerticalAlignment="Center" Opacity="0"
                                                  IsHitTestVisible="False"
                                                  TextElement.Foreground="{DynamicResource AccentBrush}"
                                                  TextElement.FontWeight="SemiBold"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 收起态分类项（问题 1）：64px 轨道里只剩图标。
             与展开态同一套交互（hover 150ms 底色 / 选中 150ms 双层文字交叉淡入），
             但几何完全不同：
               * 40x40 的方形容器（CornerRadius 8，与滑动指示块同圆角），
               * 图标 22px（展开态约 12~14px，收起后必须更大才看得清），
               * HorizontalAlignment=Center —— 容器在 46px 内容区里水平居中，
                 即 64px 卡片内左右各 12px，绝不再偏在左边；
               * 内容 Presenter 两个方向都居中，emoji 的基线差异被容器吸收（旧的"歪"就是这么来的）。 -->
        <Style x:Key="NavIconOnlyItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource Surface4Brush}"/>
                            <ContentPresenter x:Name="TextNormal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ContentPresenter x:Name="TextAccent" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10,5"
                                Background="{DynamicResource Surface4Brush}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface5Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小灰胶囊（标签：加载器 / 游戏版本 / 类别） -->
        <Style x:Key="TagPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
        </Style>

        <!-- 类别胶囊（顶部一行）。选中底色 = 容器里的滑动指示块（seg:SegmentedIndicator），
             项自己不再画选中底色（旧实现是 IsChecked 触发器直接换 Background = 硬切），
             只做 150ms 的「双层文字交叉淡入」。 -->
        <Style x:Key="CategoryPill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="15" Padding="14,7"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <ContentPresenter x:Name="TextNormal" VerticalAlignment="Center"
                                                  TextElement.FontWeight="SemiBold"/>
                                <ContentPresenter x:Name="TextAccent" VerticalAlignment="Center" Opacity="0"
                                                  IsHitTestVisible="False"
                                                  TextElement.Foreground="{DynamicResource AccentForegroundBrush}"
                                                  TextElement.FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- hover 底色只给未选中的项，selected 那项要让滑动胶囊露出来 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface4Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextNormal" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="TextAccent" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"
                                                             EasingFunction="{x:Static anim:AxolotlMotion.EaseInOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：强调色实心胶囊 -->
        <Style x:Key="PrimaryPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="18" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分页页码 -->
        <Style x:Key="PagerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface5Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 网格卡片 -->
        <Style x:Key="ProjectCard" TargetType="Border">
            <!-- ⚠ 之前写死 Width="252" + Height="170"，导致窗口宽一点也塞不进第 4 列。
                 改成 Min/Max Width + Height：WrapPanel 的 ItemWidth 决定实际列宽（响应式）。
                 252 仍是最佳体验宽度，所以 Min/Max 都锚在那个区间。 -->
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MaxWidth" Value="260"/>
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="190"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- hover 颜色过渡 250ms（Axolotl InstanceRowCard.vue:15 / GridDisplay.vue:530 的
                 transition-[...background-color...]），走 AdornerLayer 色块动画 Opacity，
                 不再用 Trigger 直接换 Background 的瞬时硬切。 -->
            <Setter Property="motion:MotionAssist.HoverTintBrush" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="motion:MotionAssist.HoverTintMs" Value="250"/>
            <Setter Property="motion:MotionAssist.HoverTintOpacity" Value="0.6"/>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface5Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProjectCardTemplate">
            <Border Style="{StaticResource ProjectCard}"
                    MouseLeftButtonUp="ProjectCard_Click" Tag="{Binding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource Surface4Brush}" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="{Binding IconImage}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Author}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11.5" Margin="0,9,0,0" MaxHeight="44"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                                <Run Text="⬇"/>
                                <Run Text="{Binding Downloads, Mode=OneWay, Converter={StaticResource DownloadCountConverter}}"/>
                            </TextBlock>
                            <Border Background="{DynamicResource InfoGlassBrush}" CornerRadius="5" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Platform}" FontSize="10" Foreground="{DynamicResource InfoBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ 安装" Style="{StaticResource MiniButton}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentForegroundBrush}"
                                    Command="{Binding DataContext.DownloadModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SkeletonCardTemplate">
            <Border Style="{StaticResource ProjectCard}">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource SkeletonPulse}"/>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource Surface4Brush}"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <Border Width="110" Height="11" CornerRadius="4" Background="{DynamicResource Surface4Brush}"/>
                            <Border Width="64" Height="9" CornerRadius="4" Background="{DynamicResource Surface4Brush}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Border Height="9" CornerRadius="4" Background="{DynamicResource Surface4Brush}"/>
                        <Border Height="9" Width="150" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Surface4Brush}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" Height="24" Width="80" CornerRadius="6" Background="{DynamicResource Surface4Brush}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 列表行卡片：缩略图 + 标题 + 平台徽标 + 简介 + 标签行 + 下载量 + 更新时间 + 「+ 安装」 -->
        <DataTemplate x:Key="ProjectRowTemplate">
            <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" Cursor="Hand"
                    MouseLeftButtonUp="ProjectCard_Click" MouseEnter="ProjectRow_MouseEnter" Tag="{Binding Project}"
                    motion:MotionAssist.HoverTintBrush="{DynamicResource Surface4Brush}"
                    motion:MotionAssist.HoverTintMs="250"
                    motion:MotionAssist.HoverTintOpacity="0.6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="56" Height="56" CornerRadius="10" VerticalAlignment="Center" ClipToBounds="True"
                            Background="{DynamicResource Surface4Brush}">
                        <Image Source="{Binding IconImage}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <Border Background="{DynamicResource InfoGlassBrush}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlatformText}" FontSize="10" Foreground="{DynamicResource InfoBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Author}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,4,0,0" MaxHeight="17"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>

                        <!-- 标签行：加载器 / 游戏版本（前 3 个）+ 类别 -->
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" ItemWidth="230" Margin="0,0,10,10"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TagPill}">
                                        <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Downloads, Mode=OneWay, Converter={StaticResource DownloadCountConverter}}"
                                   FontSize="11.5" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding UpdatedText}" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="+ 安装" Style="{StaticResource PrimaryPill}" VerticalAlignment="Center"
                            Height="32" Padding="16,0" FontSize="12.5"
                            Command="{Binding DataContext.DownloadModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding Project}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="ResourcesRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════ 左侧栏（可折叠） ══════ -->
        <!-- 侧栏卡片：顶 20 / 左 20 / 底 16，右侧 14 是与右列内容的间距。
             宽度在 212 与 64 之间由 code-behind 走 200ms cubic-bezier(0.22,1,0.36,1)
             （PageTransition.AnimateElementWidth：动画期挂 BitmapCache、结束强制定格并摘掉），
             不再用 DataTrigger 硬切；ClipToBounds 保证收缩过程中指示块 / 文字不溢出卡片。 -->
        <Border x:Name="SidebarCard" Grid.Column="0" Width="212" Margin="20,20,14,16" CornerRadius="12"
                ClipToBounds="True"
                Background="{DynamicResource Surface3Brush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                Visibility="{Binding IsFullPageView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <Grid Margin="8,10,8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 折叠小按钮 —— 两态位置不同：
                     折叠态（IsSidebarCollapsed=true）→ **Center**（用户明确要「显示在中间」）
                     展开态（false）→ **Right**（用户标红框的位置，与左侧「资源站」标题分隔）
                     ⚠ 关键：之前 converter 在 false 分支返回 Binding.DoNothing，目标会落回默认
                       Stretch（按钮被拉满整行），看起来就像「跑到了别处」。现在两态都返回明确值。 -->
                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <TextBlock x:Name="SidebarTitle" Text="资源站" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <Button x:Name="SidebarToggleBtn" Style="{StaticResource ToolButton}"
                            Height="28" MinWidth="28" Padding="0"
                            AutomationProperties.AutomationId="S2SidebarToggle"
                            Click="ToggleSidebar_Click" ToolTip="收起 / 展开侧栏"
                            HorizontalAlignment="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToHorizontalAlignmentConverter}}">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- 分类列表：指示块与两套（展开 / 折叠）列表同格叠放 -->
                <Grid x:Name="CategoryHost" Grid.Row="1">
                    <!-- 滑动指示块（Axolotl NavRail.vue:104-115 的 WPF 落地，与 MainWindow.NavSlider 同机制）：
                         单一 TranslateY 承担位移、Height 承担高度，150ms cubic-bezier(0.4,0,0.2,1)；
                         没有 BeginTime 延迟、没有 ScaleY 拉伸补偿，所以不会抖。 -->
                    <Border x:Name="CategoryIndicator" HorizontalAlignment="Left" VerticalAlignment="Top"
                            CornerRadius="8" Background="{DynamicResource AccentGlassLightBrush}"
                            IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CategoryIndicatorTranslate"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- 展开态：图标 + 文字。折叠时整块 150ms 淡出，淡出结束后 Visibility=Collapsed，
                         所以收起后绝不会残留半个字。 -->
                    <StackPanel x:Name="SidebarExpanded" VerticalAlignment="Top" Panel.ZIndex="1">
                        <RadioButton Style="{StaticResource NavItem}" Content="🧩  模组"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=mod}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="mod"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="📦  整合包"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=modpack}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="modpack"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="🖼️  资源包"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=resourcepack}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="resourcepack"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="☀️  光影"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=shader}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="shader"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="🏷️  数据包"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=datapack}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="datapack"/>

                        <Button Content="展开全部" Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{StaticResource ToolButton}"
                                AutomationProperties.AutomationId="S2ExpandAll"
                                Command="{Binding ViewMoreCommand}" ToolTip="在整页视图中浏览全部内容"/>

                        <TextBlock Text="已安装" FontSize="11" FontWeight="SemiBold" Margin="8,14,0,6"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ScrollViewer x:Name="InstalledScroll" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                            <ItemsControl ItemsSource="{Binding InstalledMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding}"/>
                                            <Button Grid.Column="1" Content="✕" FontSize="10" Width="20" Height="20" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="{DynamicResource TextTertiaryBrush}" ToolTip="删除这个文件"
                                                    Command="{Binding DataContext.RemoveInstalledModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 折叠态（问题 1）：只剩图标 —— 40x40 容器 + 22px 图标，
                         在 64px 轨道里水平 / 垂直居中；指示块按容器几何对齐（见 UpdateCategoryIndicatorCore）。 -->
                    <StackPanel x:Name="SidebarCollapsed" VerticalAlignment="Top" Panel.ZIndex="1"
                                Visibility="Collapsed">
                        <RadioButton Style="{StaticResource NavIconOnlyItem}" Content="🧩" ToolTip="模组"
                                     AutomationProperties.AutomationId="S2NavIcon-mod"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=mod}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="mod"/>
                        <RadioButton Style="{StaticResource NavIconOnlyItem}" Content="📦" ToolTip="整合包"
                                     AutomationProperties.AutomationId="S2NavIcon-modpack"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=modpack}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="modpack"/>
                        <RadioButton Style="{StaticResource NavIconOnlyItem}" Content="🖼️" ToolTip="资源包"
                                     AutomationProperties.AutomationId="S2NavIcon-resourcepack"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=resourcepack}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="resourcepack"/>
                        <RadioButton Style="{StaticResource NavIconOnlyItem}" Content="☀️" ToolTip="光影"
                                     AutomationProperties.AutomationId="S2NavIcon-shader"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=shader}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="shader"/>
                        <RadioButton Style="{StaticResource NavIconOnlyItem}" Content="🏷️" ToolTip="数据包"
                                     AutomationProperties.AutomationId="S2NavIcon-datapack"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=datapack}"
                                     Command="{Binding SwitchCategoryCommand}" CommandParameter="datapack"/>
                    </StackPanel>
                </Grid>

                <!-- 底部按钮：折叠时一起淡出（64px 宽会把按钮文字截断露出半个字） -->
                <StackPanel x:Name="SidebarFooter" Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="📦 导入整合包" Height="32" FontSize="12" Cursor="Hand" Margin="0,0,0,6"
                            Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch" Command="{Binding ImportModpackCommand}"/>
                    <Button Content="🗂 本地 Mod" Height="32" FontSize="12" Cursor="Hand"
                            Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch" Command="{Binding ToggleLocalModPanelCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════ 右侧内容 ══════ -->
        <!-- 右列整体上下留白 20 / 16；左右留白分别落在各行与结果区，避免把滚动条一起缩进 -->
        <Grid Grid.Column="1" Margin="0,20,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 内容源提示 -->
            <Grid Grid.Row="0" Margin="20,0,20,10">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCategory, Converter={StaticResource CategoryNameConverter}}"
                               FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" Text="{Binding SourceNotice}"/>
                </StackPanel>
            </Grid>

            <!-- 第一行：类别胶囊（整合包 / 模组 / 资源包 / 数据包 / 光影） -->
            <Border Grid.Row="1" Margin="20,0,20,10" CornerRadius="18" Padding="4"
                    Background="{DynamicResource Surface3Brush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="CategoryPillGroup"
                          seg:SegmentedIndicator.Host="True"
                          seg:SegmentedIndicator.Indicator="{Binding ElementName=CategoryPillIndicator}">
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="CategoryPillIndicator" CornerRadius="15" Opacity="0"
                                    Background="{DynamicResource AccentBrush}"/>
                        </Canvas>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource CategoryPill}" GroupName="ResourceCategoryTop" Content="📦  整合包"
                                         IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=modpack}"
                                         Command="{Binding SwitchCategoryCommand}" CommandParameter="modpack"/>
                            <RadioButton Style="{StaticResource CategoryPill}" GroupName="ResourceCategoryTop" Content="🧩  模组"
                                         IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=mod}"
                                         Command="{Binding SwitchCategoryCommand}" CommandParameter="mod"/>
                            <RadioButton Style="{StaticResource CategoryPill}" GroupName="ResourceCategoryTop" Content="🖼️  资源包"
                                         IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=resourcepack}"
                                         Command="{Binding SwitchCategoryCommand}" CommandParameter="resourcepack"/>
                            <RadioButton Style="{StaticResource CategoryPill}" GroupName="ResourceCategoryTop" Content="🏷️  数据包"
                                         IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=datapack}"
                                         Command="{Binding SwitchCategoryCommand}" CommandParameter="datapack"/>
                            <RadioButton Style="{StaticResource CategoryPill}" GroupName="ResourceCategoryTop" Content="☀️  光影"
                                         IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=shader}"
                                         Command="{Binding SwitchCategoryCommand}" CommandParameter="shader"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 第二行：搜索框（占满）+ 所有来源下拉 + 搜索按钮 -->
            <Grid Grid.Row="2" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource iOS26.SearchBox}" FontSize="13.5" Padding="16,9"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索模组 / 整合包 / 资源包 / 光影…">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox x:Name="SourceSelector" Grid.Column="1" Margin="8,0,0,0" Height="38" Width="182" FontSize="12.5"
                          ItemsSource="{Binding SourceOptions}" SelectedIndex="0"
                          SelectionChanged="SourceSelector_SelectionChanged"
                          ToolTip="所有来源：Modrinth / CurseForge（CurseForge 需要 API Key）"/>

                <Button Grid.Column="2" Style="{StaticResource PrimaryPill}" Margin="8,0,0,0" Height="38" Content="搜索"
                        Command="{Binding SearchCommand}"/>
            </Grid>

            <!-- 第三行：排序方式 + 查看数量 + 网格/列表切换 -->
            <Grid Grid.Row="3" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="排序方式" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <ComboBox Width="126" Height="34" FontSize="12.5" ItemsSource="{Binding SortOptions}"
                              SelectedIndex="{Binding SortIndex, Mode=TwoWay}" ToolTip="排序方式"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="查看数量" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <ComboBox Width="86" Height="34" FontSize="12.5" ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize, Mode=TwoWay}" ToolTip="每页显示数量"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource ToolButton}" Height="34" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="S2ViewToggle"
                        Command="{Binding ToggleDisplayModeCommand}" ToolTip="网格 / 列表切换">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▦" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="网格" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsListView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Text="列表" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Button>

                <ProgressBar Grid.Column="3" IsIndeterminate="{Binding IsBusy}" Height="2" Margin="14,0" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding PageIndicator}"
                           Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>

            <!-- 内容：结果区（筛选面板已搬到外壳右信息面板，见 Controls/ResourcesFilterPanel） -->
            <Grid Grid.Row="4">
                <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="ResultsScroll_ScrollChanged">
                    <!-- 结果区：左右各 20（与标题对齐），滚动条在 ScrollViewer 模板右侧列、不跟着缩进 -->
                    <StackPanel x:Name="ResultsStack" Margin="20,0,20,16">

                        <!-- 精选 -->
                        <StackPanel x:Name="FeaturedPanel" Visibility="{Binding ShowFeatured, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="🔥 热门" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="社区下载最多" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>
                            <!-- 卡片逐项错峰入场：28ms 步长 / 168ms 上限 / 180ms ease / translateY(-6px) -->
                            <ItemsControl ItemsSource="{Binding TrendingMods}" ItemTemplate="{StaticResource ProjectCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" ItemWidth="230" Margin="0,0,10,10" motion:PageAnimation.StaggerChildren="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding TrendingMods}" ItemTemplate="{StaticResource SkeletonCardTemplate}"
                                          Visibility="{Binding IsFeaturedLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" ItemWidth="230" Margin="0,0,10,10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Grid Margin="0,8,0,10">
                                <TextBlock Text="🆕 最新" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="最近更新" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding NewestMods}" ItemTemplate="{StaticResource ProjectCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" ItemWidth="230" Margin="0,0,10,10" motion:PageAnimation.StaggerChildren="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 搜索结果 -->
                        <StackPanel x:Name="SearchResultsPanel" Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="搜索结果" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}">
                                        <Run Text="{Binding SearchResults.Count, Mode=OneWay}"/>
                                        <Run Text=" 个"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="加载更多" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding LoadMoreCommand}"/>
                                    <Button Content="返回精选" Style="{StaticResource ToolButton}"
                                            AutomationProperties.AutomationId="S2BackFeatured" Command="{Binding GoBackCommand}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 网格 / 列表（问题 4）：Visibility **不再走绑定**，由 code-behind 同步接管 ——
                                 这样「切换」这一帧的账（容器生成 + 缩略图绑定 + 排列）能被完整计时，
                                 也才能做到「切之前先把另一棵视图预热好、点击只做 Visibility 对调」。
                                 没有预热时的实测：20 张卡 = 29ms、11 行列表 = 52ms（都在点击这一帧）。 -->
                            <ItemsControl x:Name="SearchGridResults" ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource ProjectCardTemplate}"
                                          Visibility="Collapsed">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Stretch" ItemWidth="230" Margin="0,0,10,10" motion:PageAnimation.StaggerChildren="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- 列表 -->
                            <ItemsControl x:Name="SearchListResults" ItemsSource="{Binding SearchRowsView}" ItemTemplate="{StaticResource ProjectRowTemplate}"
                                          Visibility="Collapsed"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="🔍" FontSize="42" HorizontalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Text="未找到内容" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="换个关键词或内容源试试" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>


                <!-- 本地 Mod 面板 -->
                <Border HorizontalAlignment="Right" Width="340" CornerRadius="12" Padding="14"
                        Background="{DynamicResource SurfaceFloatingBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        Visibility="{Binding IsLocalModPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="本地 Mod" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="添加 jar 后一起安装到当前版本" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" Padding="0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource TextSecondaryBrush}"
                                    Command="{Binding ToggleLocalModPanelCommand}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding LocalMods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource Surface4Brush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextTertiaryBrush}">
                                                            <Run Text="{Binding FileType, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="预览" Width="42" Height="24" Padding="0" FontSize="11" Margin="0,0,6,0"
                                                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource InfoBrush}"
                                                                Command="{Binding DataContext.PreviewLocalModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="✕" Width="24" Height="24" Padding="0" FontSize="11" Cursor="Hand"
                                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource DangerBrush}"
                                                                Command="{Binding DataContext.RemoveLocalModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border CornerRadius="10" Padding="10" Margin="0,4,0,0" Background="{DynamicResource Surface4Brush}"
                                        Visibility="{Binding SelectedLocalMod, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedLocalMod.FileName}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Image Source="{Binding SelectedLocalMod.PreviewImage}" Stretch="Uniform" MaxHeight="200" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="➕ 添加" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding AddLocalModCommand}"/>
                            <Button Content="安装到当前版本" Height="36" Padding="14,0" FontSize="12.5" Cursor="Hand"
                                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}"
                                    BorderThickness="0" Command="{Binding ApplyLocalModsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 导入进度 -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="12" Padding="16,12" Margin="0,0,0,8"
                        Background="{DynamicResource SurfaceFloatingBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Width="300">
                        <TextBlock Text="{Binding ImportStatus}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ProgressBar Height="5" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding ImportProgress}"
                                     Background="{DynamicResource Surface4Brush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 底部分页：上一页 + 页码 + 下一页 -->
            <Grid Grid.Row="5" Margin="20,10,20,0"
                  Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="上一页" Style="{StaticResource GhostPill}" IsEnabled="{Binding HasPrevPage}"
                            Command="{Binding PrevPageCommand}"/>

                    <ItemsControl ItemsSource="{Binding PageItems}" Margin="10,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="2,0" CommandParameter="{Binding Number}"
                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PagerButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Display}" FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="下一页" Style="{StaticResource GhostPill}" IsEnabled="{Binding HasNextPage}"
                            Command="{Binding NextPageCommand}"/>

                    <TextBlock Text="{Binding PageIndicator}" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
