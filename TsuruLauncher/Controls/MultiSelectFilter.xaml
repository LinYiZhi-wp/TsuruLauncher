<UserControl x:Class="TsuruLauncher.Controls.MultiSelectFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">

    <!-- 美西螈版本筛选的那颗下拉：滤镜图标 + 标题 + 数字角标 + 箭头，点开是一列 checkbox。
         WPF 没有 MultiSelect，这里自己拼一个；筛选逻辑全在 ViewModel（Options 里的
         FilterOption.IsSelected），控件只负责 UI 与勾选事件。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 触发按钮 -->
        <Style x:Key="TriggerStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="10" Height="34" Padding="12,0"
                                Background="{DynamicResource GlassLightBrush}"
                                BorderBrush="{DynamicResource GlassLightBrush}"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassMediumBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGlassLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉里的一行 -->
        <Style x:Key="RowStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Row" CornerRadius="8" Height="30" Padding="9,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource GlassLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentGlassLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="Trigger" Style="{StaticResource TriggerStyle}"
                      IsChecked="{Binding IsOpen, ElementName=Root, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Filter24" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="12.5" FontWeight="SemiBold"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Border x:Name="CountBadge" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                        Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock x:Name="CountText" FontSize="10.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                </Border>
                <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronDown24" FontSize="11" Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform Angle="0" CenterX="5.5" CenterY="5.5"/>
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="DropPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Placement="Bottom" PlacementTarget="{Binding ElementName=Trigger}"
               VerticalOffset="6"
               IsOpen="{Binding IsOpen, ElementName=Root, Mode=TwoWay}">
            <Border CornerRadius="14" MinWidth="180" MaxHeight="330" Margin="0,0,10,10"
                    Background="{DynamicResource SurfaceFloatingBrush}"
                    BorderBrush="{DynamicResource GlassMediumBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="5" Template="{DynamicResource GlassScrollViewer}">
                    <StackPanel>
                        <!-- 搜索框（美西螈 MultiSelect 的 searchable 属性）：
                             候选超过阈值时自动出现 —— 拉全量版本后 Fabric API 有 800+ 项，
                             没有搜索基本没法用。 -->
                        <Border x:Name="SearchWrap" Visibility="Collapsed" Margin="4,4,4,6">
                            <Grid>
                                <TextBox x:Name="SearchBox" FontSize="12" Height="32" Padding="12,5"
                                         TextChanged="SearchBox_TextChanged"
                                         Style="{DynamicResource iOS26.SearchBox}"/>
                                <TextBlock x:Name="SearchHint" Text="搜索…" FontSize="12"
                                           Margin="34,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="EmptyHint" Text="没有可筛选的项" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="9,8,9,8"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="OptionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource RowStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ui:SymbolIcon Grid.Column="1" Symbol="Checkmark24" FontSize="12"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 底部插槽（美西螈游戏版本下拉底部的「Show all versions」开关） -->
                        <Border x:Name="FooterWrap" Visibility="Collapsed" Margin="4,4,4,0"
                                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassLightBrush}">
                            <ContentPresenter x:Name="FooterHost" Content="{Binding Footer, ElementName=Root}"
                                              Margin="5,6,5,4"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
